# Server
PORT=5000
NODE_ENV=development

# Supabase - get these from your Blood Bank Supabase project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin account - created automatically on first server start
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator
ADMIN_PHONE=

# JWT secret used only by the Express API
JWT_SECRET=replace-with-a-long-random-secret

# Optional email notifications (Gmail App Password recommended)
EMAIL_USER=
EMAIL_PASS=

# Optional production/frontend URL used for password reset links
FRONTEND_URL=http://localhost:5000
