/* ==========================================================
   JHARJEEVAN — PREMIUM DESKTOP NAVBAR
   Desktop only — mobile untouched
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ---------- HEADER ---------- */

    header {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        width: 100% !important;
        height: 76px !important;

        background: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(16px) saturate(140%) !important;
        -webkit-backdrop-filter: blur(16px) saturate(140%) !important;

        border-bottom: 1px solid rgba(15, 23, 42, 0.07) !important;

        box-shadow:
            0 4px 18px rgba(15, 23, 42, 0.06),
            0 1px 0 rgba(255, 255, 255, 0.8) inset !important;

        z-index: 999999 !important;

        animation: jjNavbarDrop .65s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ---------- HEADER CONTENT ---------- */

    header .header-inner {
        width: min(1280px, calc(100% - 64px)) !important;
        max-width: 1280px !important;

        height: 76px !important;

        margin: 0 auto !important;
        padding: 0 !important;

        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;

        overflow: visible !important;
    }


    /* ---------- LOGO ---------- */

    header .header-inner > a.logo.logo-link {
        position: relative !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        justify-content: center !important;

        flex: 0 0 auto !important;

        width: auto !important;
        min-width: 210px !important;
        max-width: none !important;

        height: 100% !important;

        margin: 0 !important;
        padding: 0 !important;

        color: #dc2626 !important;
        background: transparent !important;

        text-decoration: none !important;

        opacity: 1 !important;
        visibility: visible !important;

        transform: translateZ(0) !important;

        transition:
            transform .3s cubic-bezier(.22,1,.36,1),
            filter .3s ease !important;
    }


    header .header-inner > a.logo.logo-link:hover {
        transform: translateY(-1px) !important;
        filter: brightness(.96) !important;
    }


    header .header-inner > a.logo.logo-link h1 {
        position: relative !important;

        margin: 0 !important;
        padding: 0 !important;

        color: #dc2626 !important;

        font-size: 24px !important;
        font-weight: 850 !important;

        line-height: 1 !important;
        letter-spacing: -0.65px !important;

        white-space: nowrap !important;
    }


    /* Small animated accent under logo */

    header .header-inner > a.logo.logo-link h1::after {
        content: "" !important;

        position: absolute !important;

        left: 0 !important;
        bottom: -7px !important;

        width: 0 !important;
        height: 2px !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        transition: width .35s cubic-bezier(.22,1,.36,1) !important;
    }


    header .header-inner > a.logo.logo-link:hover h1::after {
        width: 42px !important;
    }


    header .header-inner > a.logo.logo-link .tagline {
        display: block !important;

        margin: 5px 0 0 !important;
        padding: 0 !important;

        color: #64748b !important;

        font-size: 11px !important;
        font-weight: 500 !important;

        line-height: 1 !important;
        letter-spacing: .05px !important;

        white-space: nowrap !important;
    }


    /* ---------- NAVIGATION ---------- */

    header .header-inner > nav {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        flex: 1 1 auto !important;

        width: auto !important;
        min-width: 0 !important;

        height: 76px !important;

        margin: 0 !important;
        padding: 0 !important;
    }


    header .header-inner > nav > #mainNav {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        flex-direction: row !important;

        gap: 3px !important;

        width: auto !important;
        height: 76px !important;

        margin: 0 !important;
        padding: 0 !important;

        list-style: none !important;
    }


    header .header-inner > nav > #mainNav > li {
        display: flex !important;
        align-items: center !important;

        position: relative !important;

        width: auto !important;
        height: 76px !important;

        margin: 0 !important;
        padding: 0 !important;
    }


    /* ---------- NAV LINKS ---------- */

    header .header-inner > nav > #mainNav > li > a {
        position: relative !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        height: 42px !important;

        margin: 0 !important;
        padding: 0 14px !important;

        border-radius: 10px !important;

        color: #334155 !important;
        background: transparent !important;

        font-size: 14.5px !important;
        font-weight: 650 !important;

        line-height: 1 !important;
        letter-spacing: -0.05px !important;

        white-space: nowrap !important;
        text-decoration: none !important;

        transition:
            color .25s ease,
            background .25s ease,
            transform .25s cubic-bezier(.22,1,.36,1) !important;
    }


    /* Animated underline */

    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn)::after {
        content: "" !important;

        position: absolute !important;

        left: 50% !important;
        bottom: 3px !important;

        width: 0 !important;
        height: 2px !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        transform: translateX(-50%) !important;

        transition:
            width .3s cubic-bezier(.22,1,.36,1) !important;
    }


    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover {
        color: #dc2626 !important;

        background: rgba(220, 38, 38, 0.055) !important;

        transform: translateY(-1px) !important;
    }


    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover::after {
        width: 25px !important;
    }


    /* ---------- LOGIN BUTTON ---------- */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn {
        position: relative !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        overflow: hidden !important;

        min-width: 82px !important;
        height: 42px !important;

        margin-left: 11px !important;
        padding: 0 20px !important;

        border: 0 !important;
        border-radius: 11px !important;

        color: #ffffff !important;

        background: linear-gradient(
            135deg,
            #f04444 0%,
            #dc2626 55%,
            #c91f1f 100%
        ) !important;

        box-shadow:
            0 7px 18px rgba(220, 38, 38, 0.22),
            0 1px 2px rgba(127, 29, 29, 0.18) !important;

        font-size: 14.5px !important;
        font-weight: 750 !important;

        text-decoration: none !important;

        transform: translateZ(0) !important;

        transition:
            transform .3s cubic-bezier(.22,1,.36,1),
            box-shadow .3s ease,
            filter .3s ease !important;
    }


    /* Login shine animation */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: -120% !important;

        width: 70% !important;
        height: 100% !important;

        background: linear-gradient(
            105deg,
            transparent 0%,
            rgba(255,255,255,.08) 35%,
            rgba(255,255,255,.42) 50%,
            rgba(255,255,255,.08) 65%,
            transparent 100%
        ) !important;

        transform: skewX(-18deg) !important;

        transition: left .65s ease !important;

        pointer-events: none !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover {
        color: #ffffff !important;

        transform: translateY(-2px) scale(1.015) !important;

        filter: brightness(1.035) !important;

        box-shadow:
            0 11px 26px rgba(220, 38, 38, 0.30),
            0 3px 7px rgba(127, 29, 29, 0.16) !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover::before {
        left: 145% !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:active {
        transform: translateY(0) scale(.98) !important;
        box-shadow:
            0 5px 12px rgba(220, 38, 38, 0.20) !important;
    }


    /* ---------- KEYBOARD ACCESSIBILITY ---------- */

    header .header-inner > nav > #mainNav > li > a:focus-visible,
    header .header-inner > a.logo.logo-link:focus-visible {
        outline: 3px solid rgba(220, 38, 38, .22) !important;
        outline-offset: 3px !important;
    }


    /* ---------- MOBILE MENU HIDDEN ONLY ON DESKTOP ---------- */

    header .header-inner > nav > .mobile-menu {
        display: none !important;
    }


    /* ---------- ENTRY ANIMATION ---------- */

    @keyframes jjNavbarDrop {
        from {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ---------- REDUCED MOTION ---------- */

    @media (prefers-reduced-motion: reduce) {

        header,
        header .header-inner > a.logo.logo-link,
        header .header-inner > nav > #mainNav > li > a {
            animation: none !important;
            transition: none !important;
        }
    }
}


/* ==========================================================
   JHARJEEVAN — FINAL DESKTOP NAVBAR POLISH
   Remove logo underline + premium navigation effects
   MOBILE IS NOT TOUCHED
   HOME/HERO IS NOT TOUCHED
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ======================================================
       LOGO — REMOVE ALL UNDERLINES
       ====================================================== */

    header .header-inner > a.logo.logo-link,
    header .header-inner > a.logo.logo-link:hover,
    header .header-inner > a.logo.logo-link:focus,
    header .header-inner > a.logo.logo-link:active,
    header .header-inner > a.logo.logo-link:visited {
        text-decoration: none !important;
        border-bottom: none !important;
    }

    /* Remove previously-created logo pseudo-elements */
    header .header-inner > a.logo.logo-link::after,
    header .header-inner > a.logo.logo-link::before,
    header .header-inner > a.logo.logo-link h1::after,
    header .header-inner > a.logo.logo-link h1::before {
        content: none !important;
        display: none !important;
        width: 0 !important;
        height: 0 !important;
        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;
    }

    header .header-inner > a.logo.logo-link h1 {
        text-decoration: none !important;
        border: none !important;
    }

    header .header-inner > a.logo.logo-link .tagline {
        text-decoration: none !important;
        border: none !important;
    }


    /* ======================================================
       HEADER — PREMIUM DEPTH
       ====================================================== */

    header {
        background:
            linear-gradient(
                180deg,
                rgba(255,255,255,.985) 0%,
                rgba(255,255,255,.965) 100%
            ) !important;

        border-bottom:
            1px solid rgba(15,23,42,.055) !important;

        box-shadow:
            0 5px 24px rgba(15,23,42,.075),
            0 1px 0 rgba(255,255,255,.95) inset !important;

        backdrop-filter: blur(18px) saturate(145%) !important;
        -webkit-backdrop-filter: blur(18px) saturate(145%) !important;
    }


    /* ======================================================
       LOGO
