@media screen and (min-width: 769px) {

    /* ------------------------------------------------------
       DONATE SECTION
       ------------------------------------------------------ */

    #donate.donate-section {
        position: relative !important;
        padding: 82px 0 92px !important;
        overflow: hidden !important;
        background:
            radial-gradient(
                circle at 8% 20%,
                rgba(239, 68, 68, 0.055),
                transparent 28%
            ),
            radial-gradient(
                circle at 92% 82%,
                rgba(239, 68, 68, 0.035),
                transparent 30%
            ),
            #ffffff !important;
    }

    #donate.donate-section > .container {
        position: relative !important;
        max-width: 1180px !important;
        margin: 0 auto !important;
    }

    /* ------------------------------------------------------
       SECTION HEADING
       ------------------------------------------------------ */

    #donate.donate-section > .container > h2 {
        margin: 0 0 48px !important;
        text-align: center !important;

        color: #172033 !important;

        font-size: clamp(38px, 3.2vw, 50px) !important;
        font-weight: 800 !important;
        line-height: 1.12 !important;
        letter-spacing: -1.5px !important;
    }

    #donate.donate-section > .container > h2::after {
        content: "" !important;
        display: block !important;

        width: 64px !important;
        height: 4px !important;

        margin: 16px auto 0 !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 4px 12px rgba(220, 38, 38, 0.20) !important;
    }

    /* ------------------------------------------------------
       MAIN TWO-COLUMN LAYOUT
       ------------------------------------------------------ */

    #donate .donate-content {
        display: grid !important;
        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr) !important;

        gap: 32px !important;

        align-items: stretch !important;

        width: 100% !important;
        max-width: 1080px !important;

        margin: 0 auto !important;
    }

    /* ------------------------------------------------------
       BOTH CARDS
       ------------------------------------------------------ */

    #donate .donate-info,
    #donate .donate-form {
        position: relative !important;

        min-width: 0 !important;
        box-sizing: border-box !important;

        padding: 34px 32px !important;

        border-radius: 22px !important;

        background: rgba(255, 255, 255, 0.98) !important;

        border: 1px solid rgba(148, 163, 184, 0.22) !important;

        box-shadow:
            0 18px 45px rgba(15, 23, 42, 0.075),
            0 3px 10px rgba(15, 23, 42, 0.035) !important;

        overflow: hidden !important;

        transition:
            transform .28s ease,
            box-shadow .28s ease,
            border-color .28s ease !important;
    }

    #donate .donate-info::before,
    #donate .donate-form::before {
        content: "" !important;

        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 4px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626,
            #b91c1c
        ) !important;
    }

    #donate .donate-info::after,
    #donate .donate-form::after {
        content: "" !important;

        position: absolute !important;

        width: 150px !important;
        height: 150px !important;

        top: -75px !important;
        right: -75px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.055) !important;

        pointer-events: none !important;
    }

    #donate .donate-info:hover,
    #donate .donate-form:hover {
        transform: translateY(-4px) !important;

        border-color: rgba(239, 68, 68, 0.24) !important;

        box-shadow:
            0 24px 55px rgba(15, 23, 42, 0.10),
            0 5px 15px rgba(220, 38, 38, 0.055) !important;
    }

    /* ------------------------------------------------------
       LEFT CARD
       ------------------------------------------------------ */

    #donate .donate-info {
        display: flex !important;
        flex-direction: column !important;

        height: auto !important;
        min-height: 0 !important;
    }

    #donate .donate-info > h3:first-child {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;

        margin: 0 0 14px !important;

        color: #172033 !important;

        font-size: 23px !important;
        font-weight: 800 !important;
        line-height: 1.25 !important;
    }

    #donate .donate-info > h3:first-child::before {
        content: "\f4c3" !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        width: 38px !important;
        height: 38px !important;

        flex: 0 0 38px !important;

        border-radius: 11px !important;

        background: #fff1f2 !important;

        color: #ef4444 !important;

        font-family: "Font Awesome 6 Free",
                     "Font Awesome 5 Free" !important;

        font-weight: 900 !important;
        font-size: 17px !important;
    }

    #donate .donate-info > p {
        margin: 0 0 24px !important;

        color: #64748b !important;

        font-size: 15px !important;
        line-height: 1.75 !important;
    }

    #donate .donate-info > h3:not(:first-child) {
        margin: 0 0 13px !important;

        color: #172033 !important;

        font-size: 20px !important;
        font-weight: 800 !important;
        line-height: 1.3 !important;
    }

    /* ------------------------------------------------------
       ELIGIBILITY LIST
       ------------------------------------------------------ */

    #donate .donate-info > ul {
        list-style: none !important;

        margin: 0 !important;
        padding: 0 !important;
    }

    #donate .donate-info > ul > li {
        position: relative !important;

        display: flex !important;
        align-items: center !important;

        min-height: 31px !important;

        margin: 0 !important;
        padding: 3px 0 3px 30px !important;

        color: #526174 !important;

        font-size: 14px !important;
        line-height: 1.45 !important;
    }

    #donate .donate-info > ul > li::before {
        content: "\f00c" !important;

        position: absolute !important;
        left: 0 !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        width: 20px !important;
        height: 20px !important;

        border-radius: 50% !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-family: "Font Awesome 6 Free",
                     "Font Awesome 5 Free" !important;

        font-size: 10px !important;
        font-weight: 900 !important;

        box-shadow:
            0 4px 9px rgba(220, 38, 38, 0.20) !important;
    }

    /* ------------------------------------------------------
       BENEFITS
       ------------------------------------------------------ */

    #donate .benefits {
        margin-top: 22px !important;
        padding-top: 21px !important;

        border-top: 1px solid #e8edf3 !important;
    }

    #donate .benefits h3 {
        display: flex !important;
        align-items: center !important;
        gap: 12px !important;

        margin: 0 0 12px !important;

        color: #dc2626 !important;

        font-size: 18px !important;
        font-weight: 800 !important;
    }

    #donate .benefits h3::before {
        content: "\f4c3" !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        width: 36px !important;
        height: 36px !important;

        border-radius: 10px !important;

        background: #fff1f2 !important;
        color: #ef4444 !important;

        font-family: "Font Awesome 6 Free",
                     "Font Awesome 5 Free" !important;

        font-weight: 900 !important;
        font-size: 16px !important;
    }

    #donate .benefits ul {
        margin: 0 !important;
        padding: 0 !important;
    }

    #donate .benefits li {
        position: relative !important;

        min-height: 30px !important;

        padding: 4px 0 4px 30px !important;

        color: #526174 !important;

        font-size: 14px !important;
        line-height: 1.45 !important;
    }

    #donate .benefits li::before {
        left: 0 !important;
        top: 50% !important;

        transform: translateY(-50%) !important;

        color: #16a34a !important;

        font-size: 17px !important;
    }

    /* ------------------------------------------------------
       RIGHT FORM CARD
       ------------------------------------------------------ */

    #donate .donate-form {
        display: flex !important;
        flex-direction: column !important;

        min-height: 0 !important;
    }

    #donate .donate-form > h3 {
        position: relative !important;
        z-index: 2 !important;

        margin: 0 0 5px !important;

        color: #172033 !important;

        font-size: 23px !important;
        font-weight: 800 !important;
        line-height: 1.25 !important;
    }

    #donate .donate-form > h3::after {
        content: "" !important;
        display: block !important;

        width: 42px !important;
        height: 3px !important;

        margin-top: 9px !important;

        border-radius: 999px !important;

        background: #ef4444 !important;
    }

    #donate .donate-form > h3 + p {
        position: relative !important;
        z-index: 2 !important;

        margin: 8px 0 22px !important;

        color: #94a3b8 !important;

        font-size: 13px !important;
        line-height: 1.5 !important;
    }

    /* ------------------------------------------------------
       FORM GROUPS
       ------------------------------------------------------ */

    #donate #donorRegistration {
        position: relative !important;
        z-index: 2 !important;

        display: flex !important;
        flex-direction: column !important;

        gap: 13px !important;

        margin: 0 !important;
    }

    #donate #donorRegistration .form-group {
        position: relative !important;

        margin: 0 !important;
    }

    #donate #donorRegistration label {
        display: block !important;

        margin: 0 0 6px !important;

        color: #334155 !important;

        font-size: 13px !important;
        font-weight: 650 !important;
    }

    #donate #donorRegistration input,
    #donate #donorRegistration select,
    #donate #donorRegistration textarea {
        width: 100% !important;
        box-sizing: border-box !important;

        min-height: 48px !important;

        padding: 0 15px !important;

        border: 1px solid #dbe3ec !important;
        border-radius: 13px !important;

        background: #ffffff !important;

        color: #1e293b !important;

        font-size: 14px !important;

        outline: none !important;

        transition:
            border-color .2s ease,
            box-shadow .2s ease,
            transform .2s ease,
            background .2s ease !important;
    }

    #donate #donorRegistration input:hover,
    #donate #donorRegistration select:hover,
    #donate #donorRegistration textarea:hover {
        border-color: #cbd5e1 !important;
        background: #fcfdff !important;
    }

    #donate #donorRegistration input:focus,
    #donate #donorRegistration select:focus,
    #donate #donorRegistration textarea:focus {
        border-color: #ef4444 !important;

        box-shadow:
            0 0 0 4px rgba(239, 68, 68, 0.09),
            0 5px 14px rgba(15, 23, 42, 0.04) !important;

        background: #ffffff !important;
    }

    #donate #donorRegistration input::placeholder {
        color: #a3afc0 !important;
    }

    #donate #donorRegistration select {
        cursor: pointer !important;
    }

    /* ------------------------------------------------------
       VALIDATION MESSAGES
       ------------------------------------------------------ */

    #donate #donorRegistration .error-message,
    #donate #donorRegistration .field-error,
    #donate #donorRegistration .validation-error {
        margin-top: 5px !important;

        color: #dc2626 !important;

        font-size: 11px !important;
        font-weight: 600 !important;
        line-height: 1.3 !important;
    }

    /* Generic browser/HTML validation visual */
    #donate #donorRegistration input:invalid:not(:placeholder-shown),
    #donate #donorRegistration select:invalid {
        border-color: #fca5a5 !important;
    }

    /* ------------------------------------------------------
       REGISTER BUTTON
       ------------------------------------------------------ */

    #donate #donorRegistration button[type="submit"],
    #donate #donorRegistration .btn,
    #donate #donorRegistration button {
        position: relative !important;

        width: 100% !important;

        min-height: 52px !important;

        margin-top: 5px !important;

        border: 0 !important;
        border-radius: 13px !important;

        background: linear-gradient(
            135deg,
            #ef4444 0%,
            #dc2626 55%,
            #c81e1e 100%
        ) !important;

        color: #ffffff !important;

        font-size: 14px !important;
        font-weight: 750 !important;

        cursor: pointer !important;

        box-shadow:
            0 10px 24px rgba(220, 38, 38, 0.20) !important;

        overflow: hidden !important;

        transition:
            transform .22s ease,
            box-shadow .22s ease,
            filter .22s ease !important;
    }

    #donate #donorRegistration button[type="submit"]::before,
    #donate #donorRegistration .btn::before,
    #donate #donorRegistration button::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: -120% !important;

        width: 70% !important;
        height: 100% !important;

        background: linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,.28),
            transparent
        ) !important;

        transform: skewX(-20deg) !important;

        transition: left .55s ease !important;
    }

    #donate #donorRegistration button[type="submit"]:hover,
    #donate #donorRegistration .btn:hover,
    #donate #donorRegistration button:hover {
        transform: translateY(-2px) !important;

        filter: brightness(1.03) !important;

        box-shadow:
            0 14px 30px rgba(220, 38, 38, 0.28) !important;
    }

    #donate #donorRegistration button[type="submit"]:hover::before,
    #donate #donorRegistration .btn:hover::before,
    #donate #donorRegistration button:hover::before {
        left: 140% !important;
    }

    #donate #donorRegistration button[type="submit"]:active,
    #donate #donorRegistration .btn:active,
    #donate #donorRegistration button:active {
        transform: translateY(0) !important;
    }

    /* ------------------------------------------------------
       PREMIUM ACCESSIBILITY
       ------------------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        #donate .donate-info,
        #donate .donate-form,
        #donate #donorRegistration input,
        #donate #donorRegistration select,
        #donate #donorRegistration textarea,
        #donate #donorRegistration button {
            transition: none !important;
        }

        #donate #donorRegistration button::before {
            display: none !important;
        }
    }
}

/* ==========================================================
   END DONATE BLOOD DESKTOP 10/10
   ========================================================== */


/* ==========================================================
   JHARJEEVAN — DONATE BLOOD MOBILE 10/10
   MOBILE ONLY — Desktop Donate section untouched
   ========================================================== */

@media screen and (max-width: 768px) {

    /* ------------------------------------------------------
       DONATE SECTION
       ------------------------------------------------------ */

    #donate.donate-section {
        position: relative !important;

        padding: 58px 0 70px !important;

        overflow: hidden !important;

        background:
            radial-gradient(
                circle at 0% 8%,
                rgba(239, 68, 68, 0.055),
                transparent 30%
            ),
            radial-gradient(
                circle at 100% 92%,
                rgba(239, 68, 68, 0.035),
                transparent 30%
            ),
            #ffffff !important;
    }

    #donate.donate-section > .container {
        width: 100% !important;
        max-width: 100% !important;

        box-sizing: border-box !important;

        padding-left: 16px !important;
        padding-right: 16px !important;

        margin: 0 auto !important;
    }

    /* ------------------------------------------------------
       HEADING
       ------------------------------------------------------ */

    #donate.donate-section > .container > h2 {
        margin: 0 0 34px !important;

        padding: 0 10px !important;

        text-align: center !important;

        color: #172033 !important;

        font-size: 31px !important;
        line-height: 1.15 !important;

        font-weight: 800 !important;

        letter-spacing: -0.7px !important;
    }

    #donate.donate-section > .container > h2::before {
        content: "BE A HERO • SAVE LIVES" !important;

        display: block !important;

        margin-bottom: 13px !important;

        color: #ef4444 !important;

        font-size: 10px !important;
        font-weight: 800 !important;

        letter-spacing: 2.2px !important;
        line-height: 1.2 !important;
    }

    #donate.donate-section > .container > h2::after {
        content: "" !important;

        display: block !important;

        width: 54px !important;
        height: 4px !important;

        margin: 14px auto 0 !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 4px 12px rgba(220, 38, 38, 0.18) !important;
    }

    /* ------------------------------------------------------
       ONE-COLUMN MOBILE LAYOUT
       ------------------------------------------------------ */

    #donate .donate-content {
        display: flex !important;

        flex-direction: column !important;

        align-items: stretch !important;

        gap: 22px !important;

        width: 100% !important;

        margin: 0 !important;
    }

    /* ------------------------------------------------------
       BOTH CARDS
       ------------------------------------------------------ */

    #donate .donate-info,
    #donate .donate-form {

        width: 100% !important;

        max-width: 100% !important;

        min-width: 0 !important;

        box-sizing: border-box !important;

        padding: 24px 20px !important;

        margin: 0 !important;

        border-radius: 20px !important;

        border: 1px solid rgba(148, 163, 184, 0.22) !important;

        background: rgba(255, 255, 255, 0.98) !important;

        box-shadow:
            0 14px 35px rgba(15, 23, 42, 0.07),
            0 3px 10px rgba(15, 23, 42, 0.025) !important;

        position: relative !important;

        overflow: hidden !important;
    }

    #donate .donate-info::before,
    #donate .donate-form::before {

        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 3px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;
    }

    #donate .donate-info::after,
    #donate .donate-form::after {

        content: "" !important;

        position: absolute !important;

        width: 105px !important;
        height: 105px !important;

        top: -52px !important;
        right: -52px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.055) !important;

        pointer-events: none !important;
    }

    /* ------------------------------------------------------
       WHY DONATE
       ------------------------------------------------------ */

    #donate .donate-info > h3:first-child {

        position: relative !important;
        z-index: 2 !important;

        display: flex !important;

        align-items: center !important;

        gap: 10px !important;

        margin: 0 0 13px !important;

        color: #172033 !important;

        font-size: 20px !important;

        line-height: 1.25 !important;

        font-weight: 800 !important;
    }

    #donate .donate-info > h3:first-child::before {

        content: "\f4c3" !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        flex: 0 0 34px !important;

        width: 34px !important;
        height: 34px !important;

        border-radius: 10px !important;

        background: #fff1f2 !important;

        color: #ef4444 !important;

        font-family:
            "Font Awesome 6 Free",
            "Font Awesome 5 Free" !important;

        font-size: 15px !important;

        font-weight: 900 !important;
    }

    #donate .donate-info > p {

        position: relative !important;
        z-index: 2 !important;

        margin: 0 0 22px !important;

        color: #64748b !important;

        font-size: 14px !important;

        line-height: 1.72 !important;
    }

    /* ------------------------------------------------------
       ELIGIBILITY
       ------------------------------------------------------ */

    #donate .donate-info > h3:not(:first-child) {

        margin: 0 0 10px !important;

        color: #172033 !important;

        font-size: 19px !important;

        line-height: 1.3 !important;

        font-weight: 800 !important;
    }

    #donate .donate-info > ul {

        list-style: none !important;

        margin: 0 !important;

        padding: 0 !important;
    }

    #donate .donate-info > ul > li {

        position: relative !important;

        display: flex !important;

        align-items: flex-start !important;

        min-height: 29px !important;

        margin: 0 !important;

        padding: 4px 0 4px 28px !important;

        color: #526174 !important;

        font-size: 13.5px !important;

        line-height: 1.45 !important;
    }

    #donate .donate-info > ul > li::before {

        content: "\f00c" !important;

        position: absolute !important;

        left: 0 !important;

        top: 5px !important;

        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        width: 19px !important;
        height: 19px !important;

        border-radius: 50% !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-family:
            "Font Awesome 6 Free",
            "Font Awesome 5 Free" !important;

        font-size: 9px !important;

        font-weight: 900 !important;

        box-shadow:
            0 3px 8px rgba(220, 38, 38, 0.18) !important;
    }

    /* ------------------------------------------------------
       DONOR BENEFITS
       ------------------------------------------------------ */

    #donate .benefits {

        position: relative !important;

        margin-top: 17px !important;

        padding-top: 18px !important;

        border-top: 1px solid #e9edf2 !important;
    }

    #donate .benefits h3 {

        display: flex !important;

        align-items: center !important;

        gap: 10px !important;

        margin: 0 0 10px !important;

        color: #dc2626 !important;

        font-size: 18px !important;

        line-height: 1.3 !important;

        font-weight: 800 !important;
    }

    #donate .benefits h3::before {

        content: "\f4c3" !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        width: 34px !important;
        height: 34px !important;

        border-radius: 10px !important;

        background: #fff1f2 !important;

        color: #ef4444 !important;

        font-family:
            "Font Awesome 6 Free",
            "Font Awesome 5 Free" !important;

        font-size: 15px !important;

        font-weight: 900 !important;
    }

    #donate .benefits ul {

        list-style: none !important;

        margin: 0 !important;

        padding: 0 !important;
    }

    #donate .benefits li {

        position: relative !important;

        min-height: 29px !important;

        margin: 0 !important;

        padding: 4px 0 4px 28px !important;

        color: #526174 !important;

        font-size: 13.5px !important;

        line-height: 1.45 !important;
    }

    #donate .benefits li::before {

        left: 0 !important;

        top: 50% !important;

        transform: translateY(-50%) !important;

        color: #16a34a !important;

        font-size: 16px !important;
    }

    /* ------------------------------------------------------
       REGISTER FORM
       ------------------------------------------------------ */

    #donate .donate-form {

        padding: 25px 20px 22px !important;
    }

    #donate .donate-form > h3 {

        position: relative !important;
        z-index: 2 !important;

        margin: 0 !important;

        color: #172033 !important;

        font-size: 20px !important;

        line-height: 1.3 !important;

        font-weight: 800 !important;
    }

    #donate .donate-form > h3::after {

        content: "" !important;

        display: block !important;

        width: 38px !important;
        height: 3px !important;

        margin-top: 8px !important;

        border-radius: 999px !important;

        background: #ef4444 !important;
    }

    #donate .donate-form > h3 + p {

        position: relative !important;
        z-index: 2 !important;

        margin: 7px 0 18px !important;

        color: #94a3b8 !important;

        font-size: 12px !important;

        line-height: 1.5 !important;
    }

    /* ------------------------------------------------------
       FORM
       ------------------------------------------------------ */

    #donate #donorRegistration {

        position: relative !important;

        z-index: 2 !important;

        display: flex !important;

        flex-direction: column !important;

        gap: 11px !important;

        margin: 0 !important;
    }

    #donate #donorRegistration .form-group {

        margin: 0 !important;

        position: relative !important;
    }

    #donate #donorRegistration label {

        display: block !important;

        margin: 0 0 5px !important;

        color: #334155 !important;

        font-size: 12px !important;

        font-weight: 650 !important;
    }

    #donate #donorRegistration input,
    #donate #donorRegistration select,
    #donate #donorRegistration textarea {

        display: block !important;

        width: 100% !important;

        max-width: 100% !important;

        min-height: 46px !important;

        box-sizing: border-box !important;

        padding: 0 14px !important;

        border: 1px solid #dbe3ec !important;

        border-radius: 12px !important;

        background: #ffffff !important;

        color: #1e293b !important;

        font-size: 13px !important;

        outline: none !important;

        transition:
            border-color .2s ease,
            box-shadow .2s ease,
            background .2s ease !important;
    }

    #donate #donorRegistration input::placeholder {

        color: #a3afc0 !important;
    }

    #donate #donorRegistration input:focus,
    #donate #donorRegistration select:focus,
    #donate #donorRegistration textarea:focus {

        border-color: #ef4444 !important;

        box-shadow:
            0 0 0 3px rgba(239, 68, 68, 0.08) !important;

        background: #ffffff !important;
    }

    /* ------------------------------------------------------
       ERROR MESSAGE
       ------------------------------------------------------ */

    #donate #donorRegistration .error-message,
    #donate #donorRegistration .field-error,
    #donate #donorRegistration .validation-error {

        margin-top: 4px !important;

        color: #dc2626 !important;

        font-size: 10.5px !important;

        font-weight: 600 !important;

        line-height: 1.3 !important;
    }

    /* ------------------------------------------------------
       REGISTER BUTTON
       ------------------------------------------------------ */

    #donate #donorRegistration button[type="submit"],
    #donate #donorRegistration .btn,
    #donate #donorRegistration button {

        position: relative !important;

        display: flex !important;

        align-items: center !important;

        justify-content: center !important;

        width: 100% !important;

        min-height: 49px !important;

        margin-top: 3px !important;

        padding: 0 16px !important;

        border: 0 !important;

        border-radius: 12px !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-size: 13.5px !important;

        font-weight: 750 !important;

        cursor: pointer !important;

        box-shadow:
            0 9px 22px rgba(220, 38, 38, 0.20) !important;

        transition:
            transform .2s ease,
            box-shadow .2s ease !important;
    }

    #donate #donorRegistration button[type="submit"]:active,
    #donate #donorRegistration .btn:active,
    #donate #donorRegistration button:active {

        transform: scale(0.985) !important;

        box-shadow:
            0 5px 14px rgba(220, 38, 38, 0.16) !important;
    }

    /* ------------------------------------------------------
       SMALL PHONES
       ------------------------------------------------------ */

    @media screen and (max-width: 380px) {

        #donate.donate-section {
            padding-top: 50px !important;
            padding-bottom: 60px !important;
        }

        #donate.donate-section > .container {
            padding-left: 13px !important;
            padding-right: 13px !important;
        }

        #donate.donate-section > .container > h2 {
            font-size: 28px !important;
            margin-bottom: 30px !important;
        }

        #donate .donate-info,
        #donate .donate-form {
            padding-left: 18px !important;
            padding-right: 18px !important;
        }

        #donate .donate-info > p {
            font-size: 13.5px !important;
        }

        #donate .donate-info > ul > li,
        #donate .benefits li {
            font-size: 13px !important;
        }
    }

    /* ------------------------------------------------------
       REDUCE MOTION
       ------------------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        #donate #donorRegistration input,
        #donate #donorRegistration select,
        #donate #donorRegistration textarea,
        #donate #donorRegistration button {
            transition: none !important;
        }
    }
}

/* ==========================================================
   END DONATE BLOOD MOBILE 10/10
   ========================================================== */


/* ==========================================================
   JHARJEEVAN — REQUEST BLOOD DESKTOP 10/10
   Desktop only — 769px and above
   Mobile layout is NOT modified
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ------------------------------------------------------
       REQUEST SECTION
       ------------------------------------------------------ */

    #request.request-section {
        position: relative !important;

        padding: 82px 0 96px !important;

        overflow: hidden !important;

        background:
            radial-gradient(
                circle at 0% 8%,
                rgba(239, 68, 68, 0.055),
                transparent 28%
            ),
            radial-gradient(
                circle at 100% 88%,
                rgba(239, 68, 68, 0.035),
                transparent 30%
            ),
            #ffffff !important;
    }

    #request.request-section::before {
        content: "" !important;

        position: absolute !important;

        width: 360px !important;
        height: 360px !important;

        left: -210px !important;
        bottom: -180px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.025) !important;

        pointer-events: none !important;
    }

    #request.request-section > .container {
        position: relative !important;
        z-index: 2 !important;

        width: min(1180px, 92%) !important;

        max-width: 1180px !important;

        margin: 0 auto !important;

        padding: 0 !important;
    }

    /* ------------------------------------------------------
       SECTION HEADING
       ------------------------------------------------------ */

    #request.request-section > .container > h2 {
        margin: 0 0 46px !important;

        text-align: center !important;

        color: #172033 !important;

        font-size: 36px !important;

        line-height: 1.15 !important;

        font-weight: 800 !important;

        letter-spacing: -0.8px !important;
    }

    #request.request-section > .container > h2::after {
        content: "" !important;

        display: block !important;

        width: 58px !important;
        height: 4px !important;

        margin: 16px auto 0 !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 5px 14px rgba(220, 38, 38, 0.18) !important;
    }

    /* ------------------------------------------------------
       MAIN TWO-COLUMN GRID
       ------------------------------------------------------ */

    #request .request-content {
        display: grid !important;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr) !important;

        gap: 30px !important;

        align-items: stretch !important;

        width: 100% !important;

        margin: 0 !important;
    }

    /* ------------------------------------------------------
       BOTH CARDS
       ------------------------------------------------------ */

    #request .request-form,
    #request .request-info {

        position: relative !important;

        box-sizing: border-box !important;

        min-width: 0 !important;

        margin: 0 !important;

        padding: 34px 32px !important;

        border-radius: 20px !important;

        border: 1px solid rgba(148, 163, 184, 0.20) !important;

        background:
            rgba(255, 255, 255, 0.98) !important;

        box-shadow:
            0 18px 45px rgba(15, 23, 42, 0.075),
            0 3px 12px rgba(15, 23, 42, 0.025) !important;

        overflow: hidden !important;

        transition:
            transform 0.28s ease,
            box-shadow 0.28s ease,
            border-color 0.28s ease !important;
    }

    #request .request-form::before,
    #request .request-info::before {

        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 4px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;
    }

    #request .request-form::after,
    #request .request-info::after {

        content: "" !important;

        position: absolute !important;

        width: 130px !important;
        height: 130px !important;

        top: -65px !important;
        right: -65px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.045) !important;

        pointer-events: none !important;
    }

    #request .request-form:hover,
    #request .request-info:hover {

        transform: translateY(-4px) !important;

        border-color: rgba(239, 68, 68, 0.20) !important;

        box-shadow:
            0 24px 55px rgba(15, 23, 42, 0.10),
            0 5px 16px rgba(220, 38, 38, 0.035) !important;
    }

    /* ------------------------------------------------------
       FORM CARD
       ------------------------------------------------------ */

    #request .request-form {
        display: flex !important;

        flex-direction: column !important;

        justify-content: flex-start !important;
    }

    #request .request-form > h3,
    #request .request-info > h3 {

        position: relative !important;

        z-index: 2 !important;

        margin: 0 0 8px !important;

        color: #172033 !important;

        font-size: 23px !important;

        line-height: 1.25 !important;

        font-weight: 800 !important;

        letter-spacing: -0.25px !important;
    }

    #request .request-form > h3::after {

        content: "" !important;

        display: block !important;

        width: 40px !important;
        height: 3px !important;

        margin-top: 9px !important;

        border-radius: 999px !important;

        background: #ef4444 !important;
    }

    #request .request-form > h3 + p {

        position: relative !important;

        z-index: 2 !important;

        margin: 0 0 22px !important;

        color: #94a3b8 !important;

        font-size: 13px !important;

        line-height: 1.5 !important;
    }

    /* ------------------------------------------------------
       FORM SPACING
       ------------------------------------------------------ */

    #request #bloodRequestForm {

        position: relative !important;

        z-index: 2 !important;

        display: flex !important;

        flex-direction: column !important;

        gap: 13px !important;

        margin: 0 !important;
    }

    #request #bloodRequestForm .form-group {

        position: relative !important;

        margin: 0 !important;
    }

    /* ------------------------------------------------------
       INPUTS
       ------------------------------------------------------ */

    #request #bloodRequestForm input,
    #request #bloodRequestForm select,
    #request #bloodRequestForm textarea {

        box-sizing: border-box !important;

        width: 100% !important;

        max-width: 100% !important;

        min-height: 51px !important;

        padding: 0 15px !important;

        border: 1px solid #dbe3ec !important;

        border-radius: 12px !important;

        background: #ffffff !important;

        color: #1e293b !important;

        font-size: 13.5px !important;

        outline: none !important;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease,
            background 0.2s ease !important;
    }

    #request #bloodRequestForm textarea {
        min-height: 92px !important;

        padding-top: 13px !important;
        padding-bottom: 13px !important;

        resize: vertical !important;
    }

    #request #bloodRequestForm input::placeholder,
    #request #bloodRequestForm textarea::placeholder {

        color: #a3afc0 !important;
    }

    #request #bloodRequestForm input:hover,
    #request #bloodRequestForm select:hover,
    #request #bloodRequestForm textarea:hover {

        border-color: #cbd5e1 !important;
    }

    #request #bloodRequestForm input:focus,
    #request #bloodRequestForm select:focus,
    #request #bloodRequestForm textarea:focus {

        border-color: #ef4444 !important;

        background: #ffffff !important;

        box-shadow:
            0 0 0 4px rgba(239, 68, 68, 0.075) !important;

        transform: translateY(-1px) !important;
    }

    /* ------------------------------------------------------
       FORM LABELS
       ------------------------------------------------------ */

    #request #bloodRequestForm label {

        display: block !important;

        margin: 0 0 6px !important;

        color: #334155 !important;

        font-size: 12px !important;

        font-weight: 650 !important;
    }

    /* ------------------------------------------------------
       SUBMIT BUTTON
       ------------------------------------------------------ */

    #request #bloodRequestForm button[type="submit"],
    #request #bloodRequestForm .btn {

        position: relative !important;

        display: flex !important;

        align-items: center !important;

        justify-content: center !important;

        width: 100% !important;

        min-height: 52px !important;

        margin-top: 3px !important;

        padding: 0 20px !important;

        border: 0 !important;

        border-radius: 12px !important;

        background: linear-gradient(
            135deg,
            #ef4444 0%,
            #dc2626 100%
        ) !important;

        color: #ffffff !important;

        font-size: 14px !important;

        font-weight: 750 !important;

        letter-spacing: 0.1px !important;

        cursor: pointer !important;

        box-shadow:
            0 12px 25px rgba(220, 38, 38, 0.20) !important;

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease,
            filter 0.22s ease !important;
    }

    #request #bloodRequestForm button[type="submit"]:hover,
    #request #bloodRequestForm .btn:hover {

        transform: translateY(-2px) !important;

        filter: brightness(1.025) !important;

        box-shadow:
            0 16px 32px rgba(220, 38, 38, 0.27) !important;
    }

    #request #bloodRequestForm button[type="submit"]:active,
    #request #bloodRequestForm .btn:active {

        transform: translateY(0) scale(0.99) !important;

        box-shadow:
            0 8px 18px rgba(220, 38, 38, 0.20) !important;
    }

    /* ------------------------------------------------------
       REQUEST PROCESS CARD
       ------------------------------------------------------ */

    #request .request-info > h3 {

        margin-bottom: 23px !important;
    }

    #request .request-info > ol {

        position: relative !important;

        z-index: 2 !important;

        list-style: none !important;

        margin: 0 !important;

        padding: 0 !important;
    }

    #request .request-info > ol::before {

        content: "" !important;

        position: absolute !important;

        left: 15px !important;

        top: 17px !important;

        bottom: 17px !important;

        width: 2px !important;

        background: linear-gradient(
            180deg,
            rgba(239, 68, 68, 0.45),
            rgba(239, 68, 68, 0.12)
        ) !important;
    }

    #request .request-info > ol > li {

        position: relative !important;

        display: flex !important;

        align-items: center !important;

        min-height: 46px !important;

        margin: 0 0 7px !important;

        padding: 4px 0 4px 57px !important;

        color: #526174 !important;

        font-size: 13px !important;

        line-height: 1.45 !important;
    }

    #request .request-info > ol > li::before {

        content: counter(list-item) !important;

        position: absolute !important;

        left: 0 !important;
        top: 50% !important;

        transform: translateY(-50%) !important;

        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        width: 31px !important;
        height: 31px !important;

        border-radius: 50% !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-size: 11px !important;

        font-weight: 800 !important;

        box-shadow:
            0 6px 13px rgba(220, 38, 38, 0.18) !important;

        z-index: 2 !important;
    }

    #request .request-info > ol > li:hover {

        color: #334155 !important;

        transform: translateX(3px) !important;
    }

    /* ------------------------------------------------------
       EMERGENCY HELPLINE
       ------------------------------------------------------ */

    #request .emergency-contact {

        position: relative !important;

        z-index: 2 !important;

        margin-top: 22px !important;

        padding: 20px 20px !important;

        border: 1px solid rgba(239, 68, 68, 0.18) !important;

        border-radius: 16px !important;

        background:
            linear-gradient(
                135deg,
                #fff7f7,
                #fff1f2
            ) !important;

        overflow: hidden !important;

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease !important;
    }

    #request .emergency-contact::after {

        content: "" !important;

        position: absolute !important;

        width: 85px !important;
        height: 85px !important;

        right: -42px !important;
        top: -42px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.07) !important;
    }

    #request .emergency-contact:hover {

        transform: translateY(-2px) !important;

        box-shadow:
            0 10px 24px rgba(220, 38, 38, 0.08) !important;
    }

    #request .emergency-contact h4 {

        position: relative !important;
        z-index: 2 !important;

        margin: 0 0 12px !important;

        color: #dc2626 !important;

        font-size: 15px !important;

        font-weight: 800 !important;
    }

    #request .emergency-contact p {

        position: relative !important;
        z-index: 2 !important;

        display: flex !important;

        align-items: center !important;

        gap: 11px !important;

        margin: 7px 0 !important;

        color: #526174 !important;

        font-size: 12.5px !important;
    }

    #request .emergency-contact p i {

        width: 17px !important;

        color: #dc2626 !important;

        text-align: center !important;
    }

    /* ------------------------------------------------------
       RESPONSE TIME
       ------------------------------------------------------ */

    #request .response-time {

        position: relative !important;

        z-index: 2 !important;

        margin-top: 15px !important;

        padding: 18px 20px !important;

        border: 1px solid rgba(239, 68, 68, 0.13) !important;

        border-radius: 16px !important;

        background:
            linear-gradient(
                135deg,
                rgba(254, 226, 226, 0.80),
                rgba(255, 241, 242, 0.92)
            ) !important;

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease !important;
    }

    #request .response-time:hover {

        transform: translateY(-2px) !important;

        box-shadow:
            0 10px 24px rgba(220, 38, 38, 0.07) !important;
    }

    #request .response-time h4 {

        margin: 0 0 10px !important;

        color: #dc2626 !important;

        font-size: 14px !important;

        font-weight: 800 !important;
    }

    #request .response-time p {

        display: flex !important;

        align-items: center !important;

        gap: 9px !important;

        margin: 7px 0 !important;

        color: #526174 !important;

        font-size: 12.5px !important;
    }

    #request .response-time p i {

        color: #dc2626 !important;

        width: 15px !important;

        text-align: center !important;
    }

    /* ------------------------------------------------------
       VALIDATION ERRORS
       ------------------------------------------------------ */

    #request .field-error,
    #request .error-message,
    #request .validation-error {

        margin-top: 4px !important;

        color: #dc2626 !important;

        font-size: 10.5px !important;

        font-weight: 600 !important;

        line-height: 1.3 !important;
    }

    /* ------------------------------------------------------
       LARGE DESKTOP
       ------------------------------------------------------ */

    @media screen and (min-width: 1500px) {

        #request.request-section {
            padding-top: 90px !important;
            padding-bottom: 105px !important;
        }

        #request.request-section > .container {
            width: min(1240px, 90%) !important;
            max-width: 1240px !important;
        }

        #request .request-content {
            gap: 34px !important;
        }

        #request .request-form,
        #request .request-info {
            padding: 38px 36px !important;
        }
    }

    /* ------------------------------------------------------
       REDUCED MOTION
       ------------------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        #request .request-form,
        #request .request-info,
        #request .emergency-contact,
        #request .response-time,
        #request #bloodRequestForm input,
        #request #bloodRequestForm select,
        #request #bloodRequestForm textarea,
        #request #bloodRequestForm button {
            transition: none !important;
        }

        #request .request-info > ol > li:hover,
        #request .request-form:hover,
        #request .request-info:hover,
        #request .emergency-contact:hover,
        #request .response-time:hover {
            transform: none !important;
        }
    }
}

/* ==========================================================
   END REQUEST BLOOD DESKTOP 10/10
   ========================================================== */


/* ==========================================================
   JHARJEEVAN — REQUEST BLOOD MOBILE 10/10
   Mobile only — desktop remains untouched
   ========================================================== */

@media screen and (max-width: 768px) {

    /* ------------------------------------------------------
       REQUEST SECTION
       ------------------------------------------------------ */

    #request.request-section {
        padding: 58px 0 70px !important;

        overflow: hidden !important;

        background:
            radial-gradient(
                circle at 0% 5%,
                rgba(239, 68, 68, 0.055),
                transparent 32%
            ),
            radial-gradient(
                circle at 100% 90%,
                rgba(239, 68, 68, 0.035),
                transparent 32%
            ),
            #ffffff !important;
    }

    #request.request-section > .container {
        width: calc(100% - 28px) !important;

        max-width: 420px !important;

        margin: 0 auto !important;

        padding: 0 !important;
    }

    /* ------------------------------------------------------
       TITLE
       ------------------------------------------------------ */

    #request.request-section > .container > h2 {
        margin: 0 0 34px !important;

        text-align: center !important;

        font-size: clamp(28px, 8vw, 34px) !important;

        line-height: 1.15 !important;

        letter-spacing: -0.6px !important;

        color: #172033 !important;
    }

    #request.request-section > .container > h2::after {
        width: 56px !important;

        height: 4px !important;

        margin: 13px auto 0 !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 5px 14px rgba(220, 38, 38, 0.18) !important;
    }

    /* ------------------------------------------------------
       STACK CARDS
       ------------------------------------------------------ */

    #request .request-content {
        display: flex !important;

        flex-direction: column !important;

        gap: 20px !important;

        width: 100% !important;

        margin: 0 !important;
    }

    /* ------------------------------------------------------
       COMMON MOBILE CARD
       ------------------------------------------------------ */

    #request .request-form,
    #request .request-info {

        width: 100% !important;

        box-sizing: border-box !important;

        margin: 0 !important;

        padding: 25px 20px !important;

        border-radius: 18px !important;

        border: 1px solid rgba(148, 163, 184, 0.20) !important;

        background: #ffffff !important;

        box-shadow:
            0 14px 34px rgba(15, 23, 42, 0.075) !important;

        overflow: hidden !important;

        transform: none !important;
    }

    #request .request-form::before,
    #request .request-info::before {

        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 4px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;
    }

    #request .request-form::after,
    #request .request-info::after {

        content: "" !important;

        position: absolute !important;

        width: 105px !important;
        height: 105px !important;

        top: -52px !important;
        right: -52px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.055) !important;

        pointer-events: none !important;
    }

    /* ------------------------------------------------------
       FORM HEADING
       ------------------------------------------------------ */

    #request .request-form > h3,
    #request .request-info > h3 {

        position: relative !important;

        z-index: 2 !important;

        margin: 0 0 7px !important;

        color: #172033 !important;

        font-size: 20px !important;

        line-height: 1.3 !important;

        font-weight: 800 !important;

        letter-spacing: -0.25px !important;
    }

    #request .request-form > h3::after {

        content: "" !important;

        display: block !important;

        width: 35px !important;

        height: 3px !important;

        margin-top: 8px !important;

        border-radius: 999px !important;

        background: #ef4444 !important;
    }

    #request .request-form > h3 + p {

        position: relative !important;

        z-index: 2 !important;

        margin: 0 0 19px !important;

        color: #94a3b8 !important;

        font-size: 12px !important;

        line-height: 1.45 !important;
    }

    /* ------------------------------------------------------
       FORM
       ------------------------------------------------------ */

    #request #bloodRequestForm {

        position: relative !important;

        z-index: 2 !important;

        display: flex !important;

        flex-direction: column !important;

        gap: 11px !important;

        margin: 0 !important;
    }

    #request #bloodRequestForm .form-group {

        width: 100% !important;

        margin: 0 !important;
    }

    /* ------------------------------------------------------
       INPUTS
       ------------------------------------------------------ */

    #request #bloodRequestForm input,
    #request #bloodRequestForm select,
    #request #bloodRequestForm textarea {

        width: 100% !important;

        max-width: 100% !important;

        min-height: 49px !important;

        box-sizing: border-box !important;

        padding: 0 14px !important;

        border: 1px solid #dbe3ec !important;

        border-radius: 11px !important;

        background: #ffffff !important;

        color: #1e293b !important;

        font-size: 13px !important;

        outline: none !important;

        -webkit-appearance: none !important;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease !important;
    }

    #request #bloodRequestForm textarea {

        min-height: 88px !important;

        padding-top: 13px !important;

        padding-bottom: 13px !important;

        resize: vertical !important;
    }

    #request #bloodRequestForm input::placeholder,
    #request #bloodRequestForm textarea::placeholder {

        color: #a3afc0 !important;
    }

    #request #bloodRequestForm input:focus,
    #request #bloodRequestForm select:focus,
    #request #bloodRequestForm textarea:focus {

        border-color: #ef4444 !important;

        box-shadow:
            0 0 0 3px rgba(239, 68, 68, 0.07) !important;
    }

    /* ------------------------------------------------------
       LABELS
       ------------------------------------------------------ */

    #request #bloodRequestForm label {

        display: block !important;

        margin: 0 0 5px !important;

        color: #334155 !important;

        font-size: 11px !important;

        font-weight: 650 !important;
    }

    /* ------------------------------------------------------
       SUBMIT BUTTON
       ------------------------------------------------------ */

    #request #bloodRequestForm button[type="submit"],
    #request #bloodRequestForm .btn {

        width: 100% !important;

        min-height: 50px !important;

        margin-top: 3px !important;

        padding: 0 18px !important;

        border: 0 !important;

        border-radius: 11px !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-size: 13.5px !important;

        font-weight: 750 !important;

        box-shadow:
            0 11px 23px rgba(220, 38, 38, 0.20) !important;

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease !important;
    }

    #request #bloodRequestForm button[type="submit"]:active,
    #request #bloodRequestForm .btn:active {

        transform: scale(0.985) !important;

        box-shadow:
            0 7px 16px rgba(220, 38, 38, 0.18) !important;
    }

    /* ------------------------------------------------------
       PROCESS CARD
       ------------------------------------------------------ */

    #request .request-info {

        padding: 25px 20px 23px !important;
    }

    #request .request-info > h3 {

        margin-bottom: 20px !important;

        font-size: 20px !important;
    }

    #request .request-info > ol {

        position: relative !important;

        list-style: none !important;

        margin: 0 !important;

        padding: 0 !important;
    }

    #request .request-info > ol::before {

        content: "" !important;

        position: absolute !important;

        left: 15px !important;

        top: 16px !important;

        bottom: 16px !important;

        width: 2px !important;

        background: linear-gradient(
            180deg,
            rgba(239, 68, 68, 0.40),
            rgba(239, 68, 68, 0.10)
        ) !important;
    }

    #request .request-info > ol > li {

        position: relative !important;

        display: flex !important;

        align-items: center !important;

        min-height: 48px !important;

        margin: 0 !important;

        padding: 5px 0 5px 48px !important;

        color: #526174 !important;

        font-size: 12.5px !important;

        line-height: 1.45 !important;
    }

    #request .request-info > ol > li::before {

        content: counter(list-item) !important;

        position: absolute !important;

        left: 0 !important;

        top: 50% !important;

        transform: translateY(-50%) !important;

        display: flex !important;

        align-items: center !important;

        justify-content: center !important;

        width: 31px !important;

        height: 31px !important;

        border-radius: 50% !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        color: #ffffff !important;

        font-size: 10.5px !important;

        font-weight: 800 !important;

        box-shadow:
            0 6px 13px rgba(220, 38, 38, 0.18) !important;

        z-index: 2 !important;
    }

    /* ------------------------------------------------------
       EMERGENCY HELPLINE
       ------------------------------------------------------ */

    #request .emergency-contact {

        position: relative !important;

        z-index: 2 !important;

        margin-top: 19px !important;

        padding: 17px 16px !important;

        border: 1px solid rgba(239, 68, 68, 0.17) !important;

        border-radius: 15px !important;

        background:
            linear-gradient(
                135deg,
                #fff8f8,
                #fff1f2
            ) !important;
    }

    #request .emergency-contact h4 {

        margin: 0 0 11px !important;

        color: #dc2626 !important;

        font-size: 13.5px !important;

        font-weight: 800 !important;
    }

    #request .emergency-contact p {

        display: flex !important;

        align-items: center !important;

        gap: 10px !important;

        margin: 7px 0 !important;

        color: #526174 !important;

        font-size: 11.5px !important;

        line-height: 1.4 !important;
    }

    #request .emergency-contact p i {

        flex: 0 0 16px !important;

        width: 16px !important;

        color: #dc2626 !important;

        text-align: center !important;
    }

    /* ------------------------------------------------------
       RESPONSE TIME
       ------------------------------------------------------ */

    #request .response-time {

        position: relative !important;

        z-index: 2 !important;

        margin-top: 13px !important;

        padding: 16px !important;

        border: 1px solid rgba(239, 68, 68, 0.13) !important;

        border-radius: 15px !important;

        background:
            linear-gradient(
                135deg,
                #fee2e2,
                #fecdd3
            ) !important;
    }

    #request .response-time h4 {

        margin: 0 0 9px !important;

        color: #dc2626 !important;

        font-size: 13.5px !important;

        font-weight: 800 !important;
    }

    #request .response-time p {

        display: flex !important;

        align-items: center !important;

        gap: 9px !important;

        margin: 7px 0 !important;

        color: #526174 !important;

        font-size: 11.5px !important;
    }

    #request .response-time p i {

        width: 14px !important;

        color: #dc2626 !important;

        text-align: center !important;
    }

    /* ------------------------------------------------------
       VALIDATION ERRORS
       ------------------------------------------------------ */

    #request .field-error,
    #request .error-message,
    #request .validation-error {

        margin-top: 4px !important;

        color: #dc2626 !important;

        font-size: 10px !important;

        line-height: 1.3 !important;
    }

    /* ------------------------------------------------------
       SMALL PHONES
       ------------------------------------------------------ */

    @media screen and (max-width: 360px) {

        #request.request-section {
            padding-top: 50px !important;

            padding-bottom: 60px !important;
        }

        #request.request-section > .container {
            width: calc(100% - 22px) !important;
        }

        #request.request-section > .container > h2 {
            font-size: 27px !important;

            margin-bottom: 30px !important;
        }

        #request .request-form,
        #request .request-info {
            padding-left: 17px !important;

            padding-right: 17px !important;
        }

        #request .request-form > h3,
        #request .request-info > h3 {
            font-size: 19px !important;
        }

        #request .request-info > ol > li {
            padding-left: 46px !important;

            font-size: 12px !important;
        }
    }

    /* ------------------------------------------------------
       REDUCED MOTION
       ------------------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        #request #bloodRequestForm input,
        #request #bloodRequestForm select,
        #request #bloodRequestForm textarea,
        #request #bloodRequestForm button {
            transition: none !important;
        }
    }
}

/* ==========================================================
   END REQUEST BLOOD MOBILE 10/10
   ========================================================== */


/* ==========================================================
   JHARJEEVAN — BLOOD INVENTORY 10/10
   Premium responsive design + subtle animation
   Does NOT change inventory data/API logic
   ========================================================== */

#inventory.inventory-section {
    position: relative;
    overflow: hidden;

    padding: 92px 0 88px;

    background:
        radial-gradient(
            circle at 0% 30%,
            rgba(239, 68, 68, 0.065),
            transparent 30%
        ),
        radial-gradient(
            circle at 100% 75%,
            rgba(239, 68, 68, 0.045),
            transparent 30%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #fffdfd 100%
        );
}

/* Decorative background glow */
#inventory.inventory-section::before {
    content: "";

    position: absolute;

    width: 360px;
    height: 360px;

    left: -210px;
    top: 120px;

    border-radius: 50%;

    background: rgba(239, 68, 68, 0.035);

    filter: blur(12px);

    pointer-events: none;
}

#inventory.inventory-section::after {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    right: -170px;
    bottom: 60px;

    border-radius: 50%;

    background: rgba(239, 68, 68, 0.025);

    filter: blur(15px);

    pointer-events: none;
}

/* ----------------------------------------------------------
   SECTION TITLE
   ---------------------------------------------------------- */

#inventory #inventory-heading {
    position: relative;

    z-index: 2;

    margin: 0;

    text-align: center;

    color: #172033;

    font-size: clamp(30px, 3vw, 40px);

    font-weight: 850;

    letter-spacing: -0.8px;

    line-height: 1.15;
}

#inventory #inventory-heading::after {
    content: "";

    display: block;

    width: 58px;
    height: 4px;

    margin: 15px auto 0;

    border-radius: 999px;

    background: linear-gradient(
        90deg,
        #ef4444,
        #dc2626
    );

    box-shadow:
        0 5px 16px rgba(220, 38, 38, 0.20);
}

#inventory .inventory-description {
    position: relative;

    z-index: 2;

    max-width: 620px;

    margin: 17px auto 38px;

    text-align: center;

    color: #718096;

    font-size: 14px;

    line-height: 1.6;
}

/* ----------------------------------------------------------
   INVENTORY GRID
   ---------------------------------------------------------- */

#inventory .inventory-status {
    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 18px;

    max-width: 1140px;

    margin: 0 auto;
}

/* ----------------------------------------------------------
   BLOOD CARD
   ---------------------------------------------------------- */

#inventory .blood-group {
    position: relative;

    min-height: 178px;

    padding: 24px 18px 20px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    box-sizing: border-box;

    border: 1px solid rgba(148, 163, 184, 0.16);

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #ffffff 0%,
            #ffffff 65%,
            #fff8f8 100%
        );

    box-shadow:
        0 9px 25px rgba(15, 23, 42, 0.055);

    overflow: hidden;

    cursor: default;

    transform: translateY(0);

    animation:
        inventoryCardIn 0.65s cubic-bezier(.2,.7,.2,1) both;

    transition:
        transform 0.28s ease,
        box-shadow 0.28s ease,
        border-color 0.28s ease;
}

/* Stagger animation */
#inventory .blood-group:nth-child(1) {
    animation-delay: 0.04s;
}

#inventory .blood-group:nth-child(2) {
    animation-delay: 0.09s;
}

#inventory .blood-group:nth-child(3) {
    animation-delay: 0.14s;
}

#inventory .blood-group:nth-child(4) {
    animation-delay: 0.19s;
}

#inventory .blood-group:nth-child(5) {
    animation-delay: 0.24s;
}

#inventory .blood-group:nth-child(6) {
    animation-delay: 0.29s;
}

#inventory .blood-group:nth-child(7) {
    animation-delay: 0.34s;
}

#inventory .blood-group:nth-child(8) {
    animation-delay: 0.39s;
}

/* Top accent */
#inventory .blood-group::before {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    height: 4px;

    background: linear-gradient(
        90deg,
        #ef4444,
        #dc2626
    );

    transform: scaleX(0.25);

    transform-origin: center;

    transition:
        transform 0.3s ease;
}

/* Decorative corner */
#inventory .blood-group::after {
    content: "";

    position: absolute;

    width: 86px;
    height: 86px;

    right: -42px;
    top: -42px;

    border-radius: 50%;

    background: rgba(239, 68, 68, 0.055);

    pointer-events: none;
}

#inventory .blood-group:hover {
    transform: translateY(-7px);

    border-color: rgba(239, 68, 68, 0.20);

    box-shadow:
        0 18px 38px rgba(15, 23, 42, 0.10);
}

#inventory .blood-group:hover::before {
    transform: scaleX(1);
}

/* ----------------------------------------------------------
   BLOOD GROUP NAME
   ---------------------------------------------------------- */

#inventory .blood-group h3 {
    position: relative;

    z-index: 2;

    margin: 0 0 16px;

    color: #172033;

    font-size: 21px;

    font-weight: 850;

    line-height: 1;

    letter-spacing: -0.3px;
}

/* ----------------------------------------------------------
   BLOOD DROP ICON
   ---------------------------------------------------------- */

#inventory .blood-group h3::before {
    content: "";

    display: inline-block;

    width: 11px;
    height: 15px;

    margin-right: 8px;

    vertical-align: -1px;

    border-radius:
        60% 60% 60% 0;

    background: linear-gradient(
        145deg,
        #ff4b55,
        #dc2626
    );

    transform:
        rotate(-45deg);

    box-shadow:
        0 4px 10px rgba(220, 38, 38, 0.20);
}

/* ----------------------------------------------------------
   STATUS BADGE
   ---------------------------------------------------------- */

#inventory .blood-level {
    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 190px;

    min-height: 43px;

    display: flex;

    align-items: center;

    justify-content: center;

    box-sizing: border-box;

    padding: 0 14px;

    border-radius: 10px;

    font-size: 13px;

    font-weight: 800;

    letter-spacing: 0.1px;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

#inventory .blood-group:hover .blood-level {
    transform: scale(1.025);
}

/* AVAILABLE */
#inventory .blood-level.high {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #4caf50,
            #43a047
        );

    box-shadow:
        0 7px 17px rgba(76, 175, 80, 0.17);
}

/* LIMITED */
#inventory .blood-level.medium {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #ffad0a,
            #f59e0b
        );

    box-shadow:
        0 7px 17px rgba(245, 158, 11, 0.17);
}

/* CRITICAL */
#inventory .blood-level.low {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #ff4545,
            #ef3030
        );

    box-shadow:
        0 7px 17px rgba(239, 48, 48, 0.20);

    animation:
        criticalPulse 2.4s ease-in-out infinite;
}

/* ----------------------------------------------------------
   UNITS
   ---------------------------------------------------------- */

#inventory .blood-units {
    position: relative;

    z-index: 2;

    margin-top: 12px;

    color: #7b8797;

    font-size: 12px;

    font-weight: 600;

    line-height: 1.3;
}

/* ----------------------------------------------------------
   LEGEND
   ---------------------------------------------------------- */

#inventory .inventory-legend {
    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-wrap: wrap;

    gap: 20px;

    margin: 31px auto 0;

    padding: 14px 20px;

    width: fit-content;

    max-width: calc(100% - 30px);

    box-sizing: border-box;

    border: 1px solid rgba(148, 163, 184, 0.14);

    border-radius: 999px;

    background: rgba(255, 255, 255, 0.82);

    box-shadow:
        0 7px 22px rgba(15, 23, 42, 0.045);

    backdrop-filter: blur(10px);
}

#inventory .legend-item {
    display: flex;

    align-items: center;

    gap: 8px;

    color: #59677a;

    font-size: 12px;

    font-weight: 650;

    white-space: nowrap;
}

#inventory .legend-color {
    width: 13px;
    height: 13px;

    flex: 0 0 13px;

    border-radius: 4px;

    box-shadow:
        0 2px 7px rgba(15, 23, 42, 0.10);
}

#inventory .legend-color.high {
    background: #4caf50;
}

#inventory .legend-color.medium {
    background: #ff9800;
}

#inventory .legend-color.low {
    background: #f44336;
}

/* ----------------------------------------------------------
   LAST UPDATED
   ---------------------------------------------------------- */

#inventory .inventory-update {
    position: relative;

    z-index: 2;

    margin: 26px 0 0;

    text-align: center;

    color: #94a3b8;

    font-size: 11.5px;

    font-weight: 550;

    letter-spacing: 0.1px;
}

#inventory .inventory-update span {
    color: #7b8ba0;

    font-weight: 650;
}

/* ----------------------------------------------------------
   REFRESH BUTTON
   ---------------------------------------------------------- */

#inventory .inventory-actions {
    position: relative;

    z-index: 2;

    display: flex;

    justify-content: center;

    margin-top: 15px;
}

#inventory #refreshInventory {
    position: relative;

    min-width: 190px;

    min-height: 46px;

    padding: 0 20px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    border: 1px solid #ef4444;

    border-radius: 11px;

    background: #ffffff;

    color: #dc2626;

    font-size: 13px;

    font-weight: 750;

    box-shadow:
        0 7px 18px rgba(220, 38, 38, 0.07);

    cursor: pointer;

    transition:
        color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

#inventory #refreshInventory i {
    font-size: 13px;

    transition:
        transform 0.45s ease;
}

#inventory #refreshInventory:hover {
    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        );

    transform: translateY(-2px);

    box-shadow:
        0 12px 24px rgba(220, 38, 38, 0.18);
}

#inventory #refreshInventory:hover i {
    transform: rotate(180deg);
}

#inventory #refreshInventory:active {
    transform: translateY(0) scale(0.98);
}

/* ----------------------------------------------------------
   ANIMATIONS
   ---------------------------------------------------------- */

@keyframes inventoryCardIn {
    from {
        opacity: 0;

        transform:
            translateY(18px)
            scale(0.985);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}

@keyframes criticalPulse {
    0%,
    100% {
        box-shadow:
            0 7px 17px rgba(239, 48, 48, 0.18);
    }

    50% {
        box-shadow:
            0 7px 22px rgba(239, 48, 48, 0.34);
    }
}

/* ----------------------------------------------------------
   TABLET
   ---------------------------------------------------------- */

@media screen and (max-width: 900px) {

    #inventory.inventory-section {
        padding: 78px 0 72px;
    }

    #inventory .inventory-status {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 15px;
    }

    #inventory .blood-group {
        min-height: 165px;
    }
}

/* ----------------------------------------------------------
   MOBILE
   ---------------------------------------------------------- */

@media screen and (max-width: 600px) {

    #inventory.inventory-section {
        padding: 64px 0 62px;
    }

    #inventory.inventory-section > .container {
        width: calc(100% - 28px);

        max-width: 430px;

        margin: 0 auto;
    }

    #inventory #inventory-heading {
        font-size: 29px;

        letter-spacing: -0.55px;
    }

    #inventory #inventory-heading::after {
        width: 52px;

        height: 4px;

        margin-top: 13px;
    }

    #inventory .inventory-description {
        margin: 15px auto 28px;

        max-width: 340px;

        font-size: 12.5px;

        line-height: 1.55;
    }

    #inventory .inventory-status {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 11px;
    }

    #inventory .blood-group {
        min-height: 153px;

        padding: 19px 11px 17px;

        border-radius: 15px;
    }

    #inventory .blood-group h3 {
        margin-bottom: 13px;

        font-size: 18px;
    }

    #inventory .blood-group h3::before {
        width: 9px;
        height: 13px;

        margin-right: 6px;
    }

    #inventory .blood-level {
        min-height: 38px;

        padding: 0 7px;

        border-radius: 9px;

        font-size: 11px;
    }

    #inventory .blood-units {
        margin-top: 9px;

        font-size: 10.5px;
    }

    #inventory .inventory-legend {
        width: 100%;

        max-width: 100%;

        margin-top: 23px;

        padding: 13px 10px;

        gap: 10px 16px;

        border-radius: 14px;
    }

    #inventory .legend-item {
        font-size: 10.5px;
    }

    #inventory .legend-color {
        width: 11px;
        height: 11px;

        flex-basis: 11px;
    }

    #inventory .inventory-update {
        margin-top: 21px;

        font-size: 10.5px;
    }

    #inventory .inventory-actions {
        margin-top: 13px;
    }

    #inventory #refreshInventory {
        width: 100%;

        max-width: 230px;

        min-height: 46px;
    }
}

/* ----------------------------------------------------------
   VERY SMALL PHONES
   ---------------------------------------------------------- */

@media screen and (max-width: 360px) {

    #inventory.inventory-section {
        padding: 56px 0;
    }

    #inventory.inventory-section > .container {
        width: calc(100% - 22px);
    }

    #inventory .inventory-status {
        gap: 9px;
    }

    #inventory .blood-group {
        min-height: 145px;

        padding-left: 8px;
        padding-right: 8px;
    }

    #inventory .blood-group h3 {
        font-size: 17px;
    }

    #inventory .blood-level {
        font-size: 10.5px;
    }

    #inventory .legend-item {
        font-size: 10px;
    }
}

/* ----------------------------------------------------------
   ACCESSIBILITY
   ---------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

    #inventory .blood-group,
    #inventory .blood-level.low,
    #inventory #refreshInventory,
    #inventory #refreshInventory i {
        animation: none !important;

        transition: none !important;
    }
}

/* ==========================================================
   END BLOOD INVENTORY 10/10
   ========================================================== */

