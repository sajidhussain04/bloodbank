        font-size: 22px !important;
        line-height: 1.05 !important;
    }

    /* --------------------------------------------------------
       HERO
       -------------------------------------------------------- */

    #home.hero {
        width: 100% !important;
        max-width: 100% !important;

        min-height: 570px !important;
        height: 570px !important;

        margin: 0 !important;
        padding: 0 !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        background-size: cover !important;

        /*
         * Portrait-friendly crop:
         * keeps the hand/blood line visible without
         * pushing the text outside the image.
         */
        background-position: 58% center !important;

        overflow: hidden !important;
    }

    /* Prevent old decorative elements from creating seams */
    #home.hero::before,
    #home.hero::after {
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        transform: none !important;
        border-radius: 0 !important;
        margin: 0 !important;
    }

    /* --------------------------------------------------------
       HERO CONTENT
       -------------------------------------------------------- */

    #home.hero .hero-content {
        width: 100% !important;
        max-width: 100% !important;

        padding: 32px 22px !important;
        margin: 0 auto !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;

        text-align: center !important;

        box-sizing: border-box !important;
    }

    /* Small eyebrow */
    #home.hero .hero-content .eyebrow,
    #home.hero .eyebrow {
        font-size: 11px !important;
        letter-spacing: 3px !important;
        margin-bottom: 13px !important;
    }

    /* Main heading */
    #home.hero .hero-content h2 {
        width: 100% !important;
        max-width: 350px !important;

        margin: 0 auto 18px !important;
        padding: 0 !important;

        font-size: clamp(36px, 10vw, 46px) !important;
        line-height: 1.04 !important;
        letter-spacing: -1.2px !important;

        text-align: center !important;

        text-wrap: balance;
    }

    /* Description */
    #home.hero .hero-content p {
        width: 100% !important;
        max-width: 340px !important;

        margin: 0 auto 26px !important;
        padding: 0 !important;

        font-size: 15px !important;
        line-height: 1.65 !important;

        text-align: center !important;

        overflow-wrap: break-word !important;
    }

    /* --------------------------------------------------------
       BUTTONS
       -------------------------------------------------------- */

    #home.hero .hero-buttons,
    #home.hero .buttons,
    #home.hero .hero-actions {
        width: 100% !important;
        max-width: 340px !important;

        margin: 0 auto !important;
        padding: 0 !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        justify-content: center !important;

        gap: 12px !important;
    }

    #home.hero .hero-content .btn,
    #home.hero .hero-content a,
    #home.hero .btn,
    #home.hero a.btn {
        width: 100% !important;
        max-width: 340px !important;
        min-width: 0 !important;

        min-height: 56px !important;
        height: 56px !important;

        margin: 0 auto !important;
        padding: 0 20px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        box-sizing: border-box !important;

        font-size: 15px !important;
        font-weight: 700 !important;

        border-radius: 12px !important;
    }

    #home.hero .btn.primary,
    #home.hero .hero-content a:first-child {
        box-shadow:
            0 12px 28px rgba(214, 40, 40, .28) !important;
    }

    /* --------------------------------------------------------
       SMALL PHONES
       -------------------------------------------------------- */

    @media (max-width: 380px) {

        #home.hero {
            min-height: 540px !important;
            height: 540px !important;
        }

        #home.hero .hero-content {
            padding-left: 18px !important;
            padding-right: 18px !important;
        }

        #home.hero .hero-content h2 {
            font-size: 35px !important;
        }

        #home.hero .hero-content p {
            font-size: 14px !important;
            max-width: 320px !important;
        }

        #home.hero .hero-buttons,
        #home.hero .buttons,
        #home.hero .hero-actions,
        #home.hero .hero-content .btn,
        #home.hero .hero-content a {
            max-width: 100% !important;
        }
    }
}


/* ============================================================
   MOBILE NAVIGATION — CLEAN HAMBURGER
   ============================================================ */

@media (max-width: 768px) {

    nav ul,
    .nav-links,
    .nav-menu,
    .navigation-links {
        display: none !important;
    }

    .menu-toggle,
    .mobile-menu-btn,
    .hamburger,
    #menuToggle {
        display: flex !important;

        width: 42px !important;
        height: 42px !important;

        align-items: center !important;
        justify-content: center !important;

        border: 0 !important;
        border-radius: 10px !important;

        background: #fff !important;
        color: #d62828 !important;

        cursor: pointer !important;
    }
}


/* ============================================================
   TOUCH DEVICES
   ============================================================ */

@media (hover: none) and (pointer: coarse) {

    #home.hero .btn,
    #home.hero a {
        -webkit-tap-highlight-color: transparent;
    }

    #home.hero .btn:active,
    #home.hero a:active {
        transform: scale(.98) !important;
    }
}


/* ============================================================
   JHARJEEVAN FINAL RESPONSIVE POLISH
   Desktop + Tablet + Mobile
   UI ONLY — NO BACKEND/FORM LOGIC CHANGED
   ============================================================ */

/* ---------- GLOBAL RESPONSIVE SAFETY ---------- */

html {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    scroll-behavior: smooth;
}

body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

img,
video,
svg {
    max-width: 100%;
}

.container {
    width: min(1180px, calc(100% - 40px));
    margin-left: auto;
    margin-right: auto;
}

/* ---------- HEADER / NAVIGATION ---------- */

header,
.navbar,
.site-header {
    width: 100%;
    max-width: 100%;
    position: relative;
    z-index: 1000;
}

header .container,
.navbar .container,
.site-header .container {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
}

.logo {
    flex-shrink: 0;
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-left: auto;
}

.nav-links a {
    white-space: nowrap;
}

/* Hamburger is hidden on desktop */
.menu-toggle,
.mobile-menu-toggle,
#menuToggle,
.hamburger {
    display: none;
}

/* ---------- HERO DESKTOP ---------- */

#home.hero,
.hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: 555px;
    height: clamp(555px, calc(100vh - 78px), 640px);

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
}

/* Keep image readable without making it too dark */
.hero::after {
    z-index: 0;
}

.hero-content {
    position: relative;
    z-index: 2;

    width: min(900px, calc(100% - 48px));
    margin: 0 auto;

    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 56px 0 40px;
}

.hero-content h2 {
    width: 100%;
    max-width: 900px;

    margin: 0 auto 18px;

    font-size: clamp(44px, 5vw, 68px);
    line-height: 1.05;
    letter-spacing: -1.8px;

    text-align: center;
}

.hero-content p {
    width: min(820px, 100%);

    margin: 0 auto 30px;

    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.65;

    text-align: center;
}

.hero-content .btn,
.hero-content a {
    min-width: 190px;
    min-height: 56px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 14px 24px;

    border-radius: 10px;

    font-size: 15px;
    font-weight: 700;

    box-sizing: border-box;
}

.hero-content > div,
.hero-content .hero-buttons,
.hero-content .buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
}

/* ---------- TABLET ---------- */

@media (max-width: 1100px) {

    .container {
        width: min(100% - 32px, 960px);
    }

    header .container,
    .navbar .container,
    .site-header .container {
        gap: 18px;
    }

    .nav-links {
        gap: 3px;
    }

    .nav-links a {
        padding-left: 10px;
        padding-right: 10px;
        font-size: 14px;
    }

    #home.hero,
    .hero {
        min-height: 540px;
        height: clamp(540px, calc(100vh - 76px), 600px);
    }

    .hero-content {
        width: min(850px, calc(100% - 44px));
    }

    .hero-content h2 {
        font-size: clamp(42px, 5.5vw, 58px);
    }
}

/* ============================================================
   MOBILE NAVIGATION
   ============================================================ */

@media (max-width: 768px) {

    header,
    .navbar,
    .site-header {
        min-height: 64px;
        height: auto;
        background: #ffffff;
    }

    header .container,
    .navbar .container,
    .site-header .container {
        min-height: 64px;
        height: 64px;

        width: calc(100% - 28px);
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;
    }

    /* Compact mobile logo */
    .logo {
        max-width: calc(100% - 58px);

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;

        line-height: 1;
    }

    .logo span {
        line-height: 1.1;
    }

    /* Hide desktop navigation */
    .nav-links {
        position: absolute;

        top: 64px;
        left: 14px;
        right: 14px;

        width: auto;

        display: none;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;

        padding: 10px;

        background: rgba(255,255,255,.98);

        border: 1px solid rgba(214,40,40,.10);
        border-radius: 16px;

        box-shadow:
            0 18px 45px rgba(25, 30, 45, .16);

        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);

        z-index: 2000;
    }

    .nav-links.active,
    .nav-links.open,
    .nav-links.show {
        display: flex;
        animation: mobileNavIn .22s ease both;
    }

    .nav-links a {
        width: 100%;
        min-height: 46px;

        display: flex;
        align-items: center;
        justify-content: flex-start;

        padding: 12px 14px;

        border-radius: 10px;

        white-space: normal;
        box-sizing: border-box;
    }

    .nav-links a:hover,
    .nav-links a:focus {
        background: #fff4f4;
        color: #d62828;
    }

    .menu-toggle,
    .mobile-menu-toggle,
    #menuToggle,
    .hamburger {
        width: 42px;
        height: 42px;

        flex: 0 0 42px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        border: 0;
        border-radius: 11px;

        background: #fff4f4;
        color: #d62828;

        cursor: pointer;

        font-size: 20px;

        transition:
            background .2s ease,
            transform .2s ease,
            box-shadow .2s ease;
    }

    .menu-toggle:hover,
    .mobile-menu-toggle:hover,
    #menuToggle:hover,
    .hamburger:hover {
        background: #ffe8e8;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(214,40,40,.12);
    }

    /* ---------- MOBILE HERO ---------- */

    #home.hero,
    .hero {
        width: 100%;

        min-height: 0;
        height: min(610px, calc(100svh - 64px));

        display: flex;
        align-items: center;
        justify-content: center;

        background-position: center center;
        background-size: cover;

        overflow: hidden;
    }

    .hero-content {
        width: calc(100% - 32px);

        min-height: 100%;

        padding:
            clamp(42px, 9vh, 78px)
            0
            clamp(34px, 7vh, 58px);

        margin: 0 auto;

        justify-content: center;
    }

    .hero-content h2 {
        width: 100%;
        max-width: 620px;

        margin-bottom: 16px;

        font-size: clamp(38px, 10.5vw, 54px);
        line-height: 1.03;

        letter-spacing: -1.1px;

        text-align: center;
    }

    .hero-content p {
        width: min(580px, 100%);

        margin-bottom: 26px;

        padding: 0 4px;

        font-size: clamp(15px, 4vw, 18px);
        line-height: 1.55;

        text-align: center;
    }

    .hero-content > div,
    .hero-content .hero-buttons,
    .hero-content .buttons {
        width: 100%;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        gap: 12px;
    }

    .hero-content .btn,
    .hero-content a {
        width: min(360px, 100%);
        min-width: 0;

        min-height: 54px;

        padding: 14px 20px;

        border-radius: 11px;

        font-size: 15px;
    }

    /* Keep background image from overpowering mobile text */
    .hero::after {
        opacity: .72;
    }

    /* ---------- MOBILE SECTION SPACING ---------- */

    section {
        scroll-margin-top: 74px;
    }

    .section-title,
    section > h2 {
        max-width: calc(100% - 28px);
        margin-left: auto;
        margin-right: auto;

        text-align: center;
    }

    /* Prevent horizontal overflow from cards/forms */
    .about-content,
    .donate-content,
    .request-content,
    .inventory-status,
    .inventory-grid,
    .contact-content {
        max-width: 100%;
    }
}

/* ============================================================
   SMALL PHONES
   ============================================================ */

@media (max-width: 480px) {

    header .container,
    .navbar .container,
    .site-header .container {
        width: calc(100% - 20px);
        min-height: 62px;
        height: 62px;
    }

    .nav-links {
        top: 62px;
        left: 10px;
        right: 10px;
    }

    .logo {
        font-size: 21px;
    }

    .logo small,
    .logo-subtitle,
    .logo span small {
        font-size: 10px;
    }

    .menu-toggle,
    .mobile-menu-toggle,
    #menuToggle,
    .hamburger {
        width: 40px;
        height: 40px;
        flex-basis: 40px;
    }

    #home.hero,
    .hero {
        height: min(570px, calc(100svh - 62px));
    }

    .hero-content {
        width: calc(100% - 24px);

        padding-top: 42px;
        padding-bottom: 34px;
    }

    .hero-content h2 {
        max-width: 370px;

        font-size: clamp(34px, 10vw, 44px);
        line-height: 1.04;

        letter-spacing: -.8px;

        margin-bottom: 15px;
    }

    .hero-content p {
        max-width: 360px;

        font-size: 15px;
        line-height: 1.55;

        margin-bottom: 24px;
    }

    .hero-content .btn,
    .hero-content a {
        width: min(340px, 100%);
        min-height: 52px;

        font-size: 14px;
    }
}

/* ============================================================
   VERY SMALL PHONES
   ============================================================ */

@media (max-width: 360px) {

    header .container,
    .navbar .container,
    .site-header .container {
        width: calc(100% - 16px);
    }

    .logo {
        font-size: 19px;
    }

    #home.hero,
    .hero {
        height: min(550px, calc(100svh - 62px));
    }

    .hero-content {
        width: calc(100% - 20px);
        padding-top: 34px;
    }

    .hero-content h2 {
        font-size: 33px;
    }

    .hero-content p {
        font-size: 14px;
    }

    .hero-content .btn,
    .hero-content a {
        min-height: 50px;
    }
}

/* ============================================================
   LANDSCAPE MOBILE
   ============================================================ */

@media (max-width: 900px) and (orientation: landscape) {

    #home.hero,
    .hero {
        min-height: 500px;
        height: auto;
    }

    .hero-content {
        padding-top: 55px;
        padding-bottom: 55px;
    }

    .hero-content h2 {
        font-size: clamp(34px, 7vw, 50px);
    }

    .hero-content p {
        max-width: 700px;
        margin-bottom: 20px;
    }

    .hero-content > div,
    .hero-content .hero-buttons,
    .hero-content .buttons {
        flex-direction: row;
    }

    .hero-content .btn,
    .hero-content a {
        width: 180px;
    }
}

/* ============================================================
   ANIMATION
   ============================================================ */

@keyframes mobileNavIn {
    from {
        opacity: 0;
        transform: translateY(-8px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* ============================================================
   ACCESSIBILITY
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}


/* ============================================================
   FINAL DESKTOP HERO ALIGNMENT FIX
   ============================================================ */

@media (min-width: 769px) {

    /* Remove accidental space before hero */
    #home.hero,
    .hero {
        margin-top: 0 !important;
        padding-top: 0 !important;

        min-height: 560px !important;
        height: calc(100vh - 78px) !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    /* Prevent parent from creating extra vertical space */
    #home.hero:first-child,
    .hero:first-child {
        margin-top: 0 !important;
    }

    .hero-content {
        margin-top: 0 !important;
        transform: none !important;

        padding-top: 30px !important;
        padding-bottom: 30px !important;
    }

    .hero-content h2 {
        margin-top: 0 !important;
    }
}

/* ============================================================
   FINAL MOBILE PROTECTION
   Do not alter the mobile composition
   ============================================================ */

@media (max-width: 768px) {

    #home.hero,
    .hero {
        margin-top: 0 !important;
    }

    .hero-content {
        margin-top: 0 !important;
    }
}


/* ============================================================
   FINAL HERO SIZE FIX
   Desktop = compact professional hero
   Mobile = preserved
   ============================================================ */

@media (min-width: 769px) {

    #home.hero,
    .hero {
        height: 520px !important;
        min-height: 520px !important;
        max-height: 520px !important;

        margin-top: 0 !important;
        padding-top: 0 !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        overflow: hidden !important;

        background-size: cover !important;
        background-position: center center !important;
    }

    .hero-content {
        width: min(900px, calc(100% - 48px)) !important;

        padding: 20px 0 !important;
        margin: 0 auto !important;

        transform: translateY(-2px) !important;
    }

    .hero-content h2 {
        font-size: clamp(44px, 4.2vw, 62px) !important;
        line-height: 1.05 !important;

        margin: 0 auto 16px !important;
    }

    .hero-content p {
        max-width: 820px !important;

        margin: 0 auto 26px !important;

        font-size: 17px !important;
        line-height: 1.5 !important;
    }

    .hero-content .btn,
    .hero-content a {
        min-height: 54px !important;
        min-width: 180px !important;

        padding: 13px 22px !important;
    }
}


/* ============================================================
   LARGE DESKTOP
   ============================================================ */

@media (min-width: 1600px) {

    #home.hero,
    .hero {
        height: 540px !important;
        min-height: 540px !important;
        max-height: 540px !important;
    }

    .hero-content h2 {
        font-size: 64px !important;
    }
}


/* ============================================================
   MOBILE — DO NOT ENLARGE
   ============================================================ */

@media (max-width: 768px) {

    #home.hero,
    .hero {
        max-height: none !important;
    }
}


/* ============================================================
   DESKTOP HERO — FINAL COMPACT PROFESSIONAL VERSION
   ONLY applies above 768px
   MOBILE CSS IS NOT TOUCHED
   ============================================================ */

@media (min-width: 769px) {

    #home.hero,
    .hero {
        height: 470px !important;
        min-height: 470px !important;
        max-height: 470px !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: hidden !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        background-size: cover !important;
        background-position: center center !important;
    }

    .hero-content {
        width: min(920px, calc(100% - 48px)) !important;

        margin: 0 auto !important;
        padding: 0 !important;

        transform: translateY(-4px) !important;

        text-align: center !important;
    }

    .hero-content h2 {
        font-size: clamp(46px, 4vw, 60px) !important;
        line-height: 1.05 !important;

        margin: 0 auto 14px !important;
    }

    .hero-content p {
        max-width: 820px !important;

        margin: 0 auto 24px !important;

        font-size: 17px !important;
        line-height: 1.5 !important;
    }

    .hero-content .btn,
    .hero-content a {
        min-height: 54px !important;
        min-width: 185px !important;

        padding: 13px 22px !important;
    }
}


/* Larger monitors — still controlled, not oversized */
@media (min-width: 1600px) {

    #home.hero,
    .hero {
        height: 490px !important;
        min-height: 490px !important;
        max-height: 490px !important;
    }
}


/* ============================================================
   JHARJEEVAN — FINAL DESKTOP HERO POLISH
   Desktop only — mobile styles are intentionally untouched.
   ============================================================ */

@media (min-width: 769px) {

    /* Hero frame */
    #home.hero,
    .hero {
        height: 490px !important;
        min-height: 490px !important;
        max-height: 490px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        background-size: cover !important;
        background-position: center 30% !important;

        overflow: hidden !important;
        position: relative !important;
    }

    /* Keep the dark overlay elegant and consistent */
    #home.hero::after,
    .hero::after {
        opacity: 1 !important;
        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.28) 0%,
                rgba(0,0,0,.12) 48%,
                rgba(0,0,0,.28) 100%
            ) !important;
    }

    /* Main hero content */
    #home .hero-content,
    .hero .hero-content {
        width: min(1120px, 92%) !important;
        max-width: 1120px !important;

        margin: 0 auto !important;
        padding: 22px 24px 0 !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;

        text-align: center !important;

        position: relative !important;
        z-index: 2 !important;
    }

    /* Small premium eyebrow */
    #home .hero-content::before,
    .hero .hero-content::before {
        content: "BE A HERO  •  SAVE LIVES" !important;

        display: block !important;
        margin-bottom: 18px !important;

        color: #ff3434 !important;
        font-size: 13px !important;
        font-weight: 800 !important;
        letter-spacing: 4px !important;
        line-height: 1 !important;

        text-shadow:
            0 2px 8px rgba(0,0,0,.45) !important;

        animation: desktopHeroEyebrow 0.8s ease both !important;
    }

    /* Main heading */
    #home .hero-content h2,
    .hero .hero-content h2 {
        width: 100% !important;
        max-width: 1000px !important;

        margin: 0 auto 16px !important;
        padding: 0 !important;

        color: #ffffff !important;

        font-size: clamp(48px, 4.1vw, 62px) !important;
        line-height: 1.06 !important;
        font-weight: 800 !important;
        letter-spacing: -1.8px !important;

        text-align: center !important;

        text-shadow:
            0 3px 0 rgba(0,0,0,.18),
            0 7px 20px rgba(0,0,0,.58) !important;

        animation: desktopHeroTitle 0.9s .08s ease both !important;
    }

    /* Description */
    #home .hero-content p,
    .hero .hero-content p {
        width: 100% !important;
        max-width: 820px !important;

        margin: 0 auto 28px !important;
        padding: 0 !important;

        color: rgba(255,255,255,.96) !important;

        font-size: 17px !important;
        line-height: 1.55 !important;
        font-weight: 500 !important;

        text-align: center !important;

        text-shadow:
            0 2px 10px rgba(0,0,0,.65) !important;

        animation: desktopHeroText 0.9s .16s ease both !important;
    }

    /* Button row */
    #home .hero-content .btn,
    #home .hero-content a,
    .hero .hero-content .btn,
    .hero .hero-content a {
        min-width: 184px !important;
        height: 56px !important;

        padding: 0 28px !important;
        margin: 0 5px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        border-radius: 10px !important;

        font-size: 15px !important;
        font-weight: 700 !important;
        line-height: 1 !important;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background .25s ease,
            border-color .25s ease !important;

        animation: desktopHeroButtons .9s .24s ease both !important;
    }

    /* Primary CTA */
    #home .hero-content .btn.primary,
    .hero .hero-content .btn.primary {
        background:
            linear-gradient(
                135deg,
                #f32f38 0%,
                #dc2029 100%
            ) !important;

        border: 1px solid rgba(255,255,255,.08) !important;

        box-shadow:
            0 12px 28px rgba(220,32,41,.32) !important;
    }

    #home .hero-content .btn.primary:hover,
    .hero .hero-content .btn.primary:hover {
        transform: translateY(-3px) !important;

        box-shadow:
            0 17px 34px rgba(220,32,41,.42) !important;
    }

    /* Secondary CTA */
    #home .hero-content .btn.secondary,
    .hero .hero-content .btn.secondary {
        background: rgba(255,255,255,.08) !important;

        border: 2px solid rgba(255,255,255,.88) !important;

        color: #ffffff !important;

        box-shadow:
            0 8px 20px rgba(0,0,0,.14) !important;

        backdrop-filter: blur(5px) !important;
        -webkit-backdrop-filter: blur(5px) !important;
    }

    #home .hero-content .btn.secondary:hover,
    .hero .hero-content .btn.secondary:hover {
        transform: translateY(-3px) !important;

        background: rgba(255,255,255,.17) !important;

        border-color: #ffffff !important;

        box-shadow:
            0 14px 28px rgba(0,0,0,.20) !important;
    }

    /* Smooth entrance animations */
    @keyframes desktopHeroEyebrow {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes desktopHeroTitle {
        from {
            opacity: 0;
            transform: translateY(18px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes desktopHeroText {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes desktopHeroButtons {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
}

/* ============================================================
   END — DESKTOP ONLY
   Nothing below 769px is changed.
   ============================================================ */

/* ============================================================
   JHARJEEVAN — FINAL DESKTOP HERO
   10/10 PROFESSIONAL POLISH
   IMPORTANT: DESKTOP ONLY — MOBILE UNTOUCHED
   ============================================================ */

@media screen and (min-width: 769px) {

    /* --------------------------------------------------------
       HERO CONTAINER
       -------------------------------------------------------- */

    #home.hero,
    .hero {
        position: relative !important;

        height: 480px !important;
        min-height: 480px !important;
        max-height: 480px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        overflow: hidden !important;

        background-size: cover !important;

        /*
         * Keeps the hands and red blood line visible
         * while preventing the arm from dominating the hero.
         */
        background-position: center 27% !important;
    }


    /* --------------------------------------------------------
       HERO OVERLAY
       Subtle dark overlay for premium readability.
       -------------------------------------------------------- */

    #home.hero::after,
    .hero::after {
        content: "" !important;

        position: absolute !important;
        inset: 0 !important;

        z-index: 1 !important;

        pointer-events: none !important;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.30) 0%,
                rgba(0,0,0,.17) 42%,
                rgba(0,0,0,.12) 60%,
                rgba(0,0,0,.28) 100%
            ) !important;
    }


    /* --------------------------------------------------------
       HERO CONTENT
       -------------------------------------------------------- */

    #home .hero-content,
    .hero .hero-content {
        position: relative !important;
        z-index: 3 !important;

        width: min(1100px, 92%) !important;
        max-width: 1100px !important;

        margin: 0 auto !important;

        padding:
            12px 24px 0 !important;

        display: flex !important;
        flex-direction: column !important;

        align-items: center !important;
        justify-content: center !important;

        text-align: center !important;
    }


    /* --------------------------------------------------------
       EYEBROW
       -------------------------------------------------------- */

    #home .hero-content::before,
    .hero .hero-content::before {
        content: "BE A HERO  •  SAVE LIVES" !important;

        display: block !important;

        margin:
            0 0 17px !important;

        color: #ff3434 !important;

        font-size: 12px !important;
        font-weight: 800 !important;

        letter-spacing: 4px !important;
        line-height: 1 !important;

        text-align: center !important;

        text-shadow:
            0 2px 8px rgba(0,0,0,.55) !important;
    }


    /* --------------------------------------------------------
       MAIN HEADING
       -------------------------------------------------------- */

    #home .hero-content h2,
    .hero .hero-content h2 {
        width: 100% !important;

        max-width: 930px !important;

        margin:
            0 auto 14px !important;

        padding: 0 !important;

        color: #ffffff !important;

        font-size: clamp(46px, 4vw, 58px) !important;

        line-height: 1.06 !important;

        font-weight: 800 !important;

        letter-spacing: -1.6px !important;

        text-align: center !important;

        text-wrap: balance !important;

        text-shadow:
            0 3px 0 rgba(0,0,0,.18),
            0 7px 18px rgba(0,0,0,.62) !important;
    }


    /* --------------------------------------------------------
       DESCRIPTION
       -------------------------------------------------------- */

    #home .hero-content p,
    .hero .hero-content p {
        width: 100% !important;

        max-width: 800px !important;

        margin:
            0 auto 27px !important;

        padding: 0 !important;

        color: rgba(255,255,255,.96) !important;

        font-size: 16px !important;

        line-height: 1.55 !important;

        font-weight: 500 !important;

        text-align: center !important;

        text-wrap: balance !important;

        text-shadow:
            0 2px 9px rgba(0,0,0,.72) !important;
    }


    /* --------------------------------------------------------
       CTA ROW
       -------------------------------------------------------- */

    #home .hero-content .btn,
    #home .hero-content a,
    .hero .hero-content .btn,
    .hero .hero-content a {
        min-width: 184px !important;

        height: 54px !important;

        margin:
            0 4px !important;

        padding:
            0 27px !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        border-radius: 10px !important;

        font-size: 15px !important;

        font-weight: 700 !important;

        line-height: 1 !important;

        text-decoration: none !important;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            background .25s ease,
            border-color .25s ease !important;
    }


    /* --------------------------------------------------------
       PRIMARY BUTTON
       -------------------------------------------------------- */

    #home .hero-content .btn.primary,
    .hero .hero-content .btn.primary {
        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #f52d36 0%,
                #df2029 100%
            ) !important;

        border:
            1px solid rgba(255,255,255,.10) !important;

        box-shadow:
            0 10px 25px rgba(220,32,41,.32) !important;
    }


    #home .hero-content .btn.primary:hover,
    .hero .hero-content .btn.primary:hover {
        transform:
            translateY(-3px) !important;

        box-shadow:
            0 16px 32px rgba(220,32,41,.43) !important;
    }


    /* --------------------------------------------------------
       SECONDARY BUTTON
       -------------------------------------------------------- */

    #home .hero-content .btn.secondary,
    .hero .hero-content .btn.secondary {
        color: #ffffff !important;

        background:
            rgba(255,255,255,.07) !important;

        border:
            2px solid rgba(255,255,255,.88) !important;

        box-shadow:
            0 7px 18px rgba(0,0,0,.14) !important;

        backdrop-filter:
            blur(4px) !important;

        -webkit-backdrop-filter:
            blur(4px) !important;
    }


    #home .hero-content .btn.secondary:hover,
    .hero .hero-content .btn.secondary:hover {
        transform:
            translateY(-3px) !important;

        color: #ffffff !important;

        background:
            rgba(255,255,255,.16) !important;

        border-color:
            #ffffff !important;

        box-shadow:
            0 14px 27px rgba(0,0,0,.20) !important;
    }


    /* --------------------------------------------------------
       HERO CONTENT SPACING
       Prevents the content from feeling too low/high.
       -------------------------------------------------------- */

    #home .hero-content > * {
        flex-shrink: 0 !important;
    }


    /* --------------------------------------------------------
       REDUCE VISUAL COMPETITION FROM BACKGROUND
       -------------------------------------------------------- */

    #home.hero::before,
    .hero::before {
        pointer-events: none !important;
    }


    /* --------------------------------------------------------
       LARGE DESKTOP — 1440px+
       -------------------------------------------------------- */

    @media screen and (min-width: 1440px) {

        #home.hero,
        .hero {
            height: 485px !important;
            min-height: 485px !important;
            max-height: 485px !important;

            background-position:
                center 25% !important;
        }

        #home .hero-content,
        .hero .hero-content {
            padding-top: 8px !important;
        }

        #home .hero-content h2,
        .hero .hero-content h2 {
            font-size: 58px !important;
            max-width: 950px !important;
        }

        #home .hero-content p,
        .hero .hero-content p {
            font-size: 16px !important;
            max-width: 810px !important;
        }
    }


    /* --------------------------------------------------------
       TABLET / SMALL DESKTOP
       -------------------------------------------------------- */

    @media screen and (min-width: 769px) and (max-width: 1100px) {

        #home.hero,
        .hero {
            height: 460px !important;
            min-height: 460px !important;
            max-height: 460px !important;

            background-position:
                center 28% !important;
        }

        #home .hero-content h2,
        .hero .hero-content h2 {
            font-size: 46px !important;
        }

        #home .hero-content p,
        .hero .hero-content p {
            max-width: 700px !important;
            font-size: 15px !important;
        }
    }
}


/* ============================================================
   FINAL DESKTOP HERO END
   NO MOBILE RULES BELOW THIS POINT
   ============================================================ */

/* =========================================================
   DESKTOP NAVBAR — STICKY PROFESSIONAL FIX
   Mobile styles are intentionally untouched.
   ========================================================= */

@media (min-width: 769px) {
  header {
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
    background: #ffffff !important;
    box-shadow: 0 2px 14px rgba(15, 23, 42, 0.08) !important;
  }

  header .container {
    min-height: 78px;
  }

  header nav {
    position: relative;
    z-index: 1001;
  }

  header a,
  header button {
    position: relative;
    z-index: 1002;
  }
}

/* =========================================================
   JHARJEEVAN — DESKTOP STICKY NAVBAR FINAL FIX
   Mobile layout is intentionally NOT modified.
   ========================================================= */

@media screen and (min-width: 769px) {

  /* Keep the real navigation bar permanently visible */
  header,
  .header,
  .navbar,
  nav {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;

    z-index: 9999 !important;

    background: #ffffff !important;
    opacity: 1 !important;

    box-shadow:
      0 2px 12px rgba(15, 23, 42, 0.08) !important;
  }

  /* Keep navbar contents above everything */
  header *,
  .header *,
  .navbar *,
  nav * {
    position: relative;
    z-index: 10000;
  }

  /* Prevent page content from going underneath fixed navbar */
  body {
    padding-top: 78px !important;
  }

  /* Don't allow sections to hide behind navbar when using anchors */
  section[id] {
    scroll-margin-top: 90px;
  }
}


/* ============================================================
   JHARJEEVAN — PREMIUM DESKTOP NAVBAR
   Desktop only — MOBILE IS NOT TOUCHED
   ============================================================ */

@media screen and (min-width: 769px) {

  /* ----------------------------------------------------------
     MAIN NAVBAR
     ---------------------------------------------------------- */

  header {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;

    width: 100% !important;
    height: 78px !important;

    z-index: 99999 !important;

    background: rgba(255, 255, 255, 0.96) !important;

    border-bottom: 1px solid rgba(220, 38, 38, 0.08) !important;

    box-shadow:
      0 4px 20px rgba(15, 23, 42, 0.07),
      0 1px 3px rgba(15, 23, 42, 0.04) !important;

    backdrop-filter: blur(18px) saturate(150%) !important;
    -webkit-backdrop-filter: blur(18px) saturate(150%) !important;

    animation: jjNavbarEnter .65s cubic-bezier(.22,1,.36,1) both;
  }


  /* ----------------------------------------------------------
     HEADER INNER CONTENT
     ---------------------------------------------------------- */

  header .container,
  header .header-container,
  header > .container {
    height: 78px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;

    max-width: 1200px !important;
    margin: 0 auto !important;

    padding-left: 22px !important;
    padding-right: 22px !important;
  }


  /* ----------------------------------------------------------
     LOGO
     ---------------------------------------------------------- */

  header .logo {
    display: inline-flex !important;
    align-items: center !important;

    flex-shrink: 0 !important;

    position: relative !important;

    color: #dc2626 !important;

    font-size: 24px !important;
    font-weight: 800 !important;

    line-height: 1 !important;
    letter-spacing: -0.6px !important;

    text-decoration: none !important;

    transition:
      transform .25s ease,
      color .25s ease,
      filter .25s ease !important;
  }


  header .logo:hover {
    color: #b91c1c !important;

    transform: translateY(-1px) !important;

    filter:
      drop-shadow(0 5px 10px rgba(220,38,38,.16)) !important;
  }


  header .logo::after {
    content: "" !important;

    position: absolute !important;

    left: 0 !important;
    bottom: -8px !important;

    width: 0 !important;
    height: 2px !important;

    border-radius: 999px !important;

    background: #dc2626 !important;

    transition: width .3s ease !important;
  }


  header .logo:hover::after {
    width: 32px !important;
  }


  /* ----------------------------------------------------------
     NAVIGATION
     ---------------------------------------------------------- */

  header nav {
    display: flex !important;
    align-items: center !important;

    height: 100% !important;

    margin-left: auto !important;
  }


  header nav ul {
    display: flex !important;
    align-items: center !important;

    gap: 7px !important;

    height: 100% !important;

    margin: 0 !important;
    padding: 0 !important;

    list-style: none !important;
  }


  header nav li {
    display: flex !important;
    align-items: center !important;

    height: 100% !important;

    margin: 0 !important;
    padding: 0 !important;
  }


  /* ----------------------------------------------------------
     NAV LINKS
     ---------------------------------------------------------- */

  header nav a {
    position: relative !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    min-height: 42px !important;

    padding: 0 15px !important;

    border-radius: 11px !important;

    color: #334155 !important;

    font-size: 15px !important;
    font-weight: 600 !important;

    line-height: 1 !important;

    text-decoration: none !important;

    white-space: nowrap !important;

    transition:
      color .25s ease,
      background .25s ease,
      transform .25s ease,
      box-shadow .25s ease !important;
  }


  header nav a::before {
    content: "" !important;

    position: absolute !important;

    left: 50% !important;
    bottom: 5px !important;

    width: 0 !important;
    height: 2px !important;

    border-radius: 999px !important;

    background: #dc2626 !important;

    transform: translateX(-50%) !important;

    transition: width .25s ease !important;
  }


  header nav a:hover {
    color: #dc2626 !important;

    background: rgba(220, 38, 38, 0.055) !important;

    transform: translateY(-1px) !important;
  }


  header nav a:hover::before {
    width: 22px !important;
  }


  /* ----------------------------------------------------------
     ACTIVE NAVIGATION
     ---------------------------------------------------------- */

  header nav a.active,
  header nav a[aria-current="page"] {
    color: #dc2626 !important;

    background:
      linear-gradient(
        135deg,
        rgba(220,38,38,.10),
        rgba(220,38,38,.045)
      ) !important;

    box-shadow:
      inset 0 0 0 1px rgba(220,38,38,.07) !important;
  }


  header nav a.active::before,
  header nav a[aria-current="page"]::before {
    width: 24px !important;
  }


  /* ----------------------------------------------------------
     LOGIN BUTTON
     ---------------------------------------------------------- */

  header nav a[href*="admin"],
  header nav a.login,
  header nav .login-btn {
    margin-left: 9px !important;

    min-width: 76px !important;
    min-height: 42px !important;

    padding: 0 19px !important;

    border-radius: 10px !important;

    color: #ffffff !important;

    background:
      linear-gradient(
        135deg,
        #ef4444 0%,
        #dc2626 55%,
        #c81e1e 100%
      ) !important;

    box-shadow:
      0 8px 18px rgba(220,38,38,.22),
      inset 0 1px 0 rgba(255,255,255,.20) !important;

    font-weight: 700 !important;

    transition:
      transform .25s ease,
      box-shadow .25s ease,
      filter .25s ease !important;
  }


  header nav a[href*="admin"]::before,
  header nav a.login::before,
  header nav .login-btn::before {
    display: none !important;
  }


  header nav a[href*="admin"]:hover,
  header nav a.login:hover,
  header nav .login-btn:hover {
    color: #ffffff !important;

    background:
      linear-gradient(
        135deg,
        #f05252,
        #dc2626
      ) !important;

    transform: translateY(-2px) !important;

    box-shadow:
      0 12px 25px rgba(220,38,38,.30),
      inset 0 1px 0 rgba(255,255,255,.25) !important;

    filter: brightness(1.03) !important;
  }


  header nav a[href*="admin"]:active,
  header nav a.login:active,
  header nav .login-btn:active {
    transform: translateY(0) scale(.97) !important;
  }


  /* ----------------------------------------------------------
     SCROLL FEEL
     ---------------------------------------------------------- */

  body {
    padding-top: 78px !important;
  }


  /* Prevent anchor sections from hiding beneath navbar */

  section[id] {
    scroll-margin-top: 94px !important;
  }


  /* ----------------------------------------------------------
     NAVBAR ENTRANCE ANIMATION
     ---------------------------------------------------------- */

  @keyframes jjNavbarEnter {

    from {
      opacity: 0;
      transform: translateY(-12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }


  /* ----------------------------------------------------------
     REDUCED MOTION
     ---------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {

    header {
      animation: none !important;
    }

    header *,
    header *::before,
    header *::after {
      transition: none !important;
    }

  }

}


