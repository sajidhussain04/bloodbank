        height: 2px !important;

        border-radius: 999px !important;

        background: #dc2626 !important;

        transform: translateX(-50%) !important;

        transition: width .25s ease !important;
    }


    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover {
        color: #dc2626 !important;

        background: rgba(220, 38, 38, .055) !important;

        transform: translateY(-1px) !important;
    }


    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover::after {
        width: 24px !important;
    }


    /* ========================================================
       LOGIN BUTTON
       ======================================================== */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn {
        min-width: 78px !important;

        height: 42px !important;

        margin-left: 9px !important;

        padding: 0 19px !important;

        border-radius: 10px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef4444 0%,
                #dc2626 100%
            ) !important;

        box-shadow:
            0 7px 18px rgba(220, 38, 38, .20) !important;

        font-size: 15px !important;
        font-weight: 700 !important;

        text-decoration: none !important;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            filter .25s ease !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover {
        color: #ffffff !important;

        transform: translateY(-2px) !important;

        box-shadow:
            0 12px 26px rgba(220, 38, 38, .30) !important;

        filter: brightness(1.04) !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:active {
        transform: scale(.97) !important;
    }


    /* Mobile menu never appears on desktop */

    header .header-inner .mobile-menu {
        display: none !important;
    }


    /* ========================================================
       HERO
       ======================================================== */

    body {
        padding-top: 78px !important;
        overflow-x: hidden !important;
    }


    #home.hero {
        position: relative !important;

        width: 100% !important;

        height: 500px !important;
        min-height: 500px !important;

        overflow: hidden !important;

        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        background-position:
            center 30% !important;

        background-size:
            cover !important;
    }


    /* Slightly stronger but clean overlay */

    #home.hero::after {
        content: "" !important;

        position: absolute !important;

        inset: 0 !important;

        z-index: 1 !important;

        pointer-events: none !important;

        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,.12) 0%,
                rgba(0,0,0,.18) 55%,
                rgba(0,0,0,.28) 100%
            ) !important;
    }


    /* ---------- HERO CONTENT ---------- */

    #home.hero .hero-content {
        position: relative !important;

        z-index: 2 !important;

        width: 100% !important;

        max-width: 1050px !important;

        margin: 0 auto !important;

        padding: 0 30px !important;

        text-align: center !important;

        box-sizing: border-box !important;

        transform: translateY(-3px) !important;
    }


    /* ---------- HERO HEADING ---------- */

    #home.hero .hero-content h2 {
        margin: 0 auto 18px !important;

        max-width: 900px !important;

        font-size:
            clamp(48px, 5vw, 66px) !important;

        line-height: 1.04 !important;

        letter-spacing: -2px !important;

        text-align: center !important;

        text-shadow:
            0 4px 12px rgba(0,0,0,.45) !important;
    }


    /* ---------- HERO DESCRIPTION ---------- */

    #home.hero .hero-content p {
        max-width: 760px !important;

        margin: 0 auto 30px !important;

        font-size: 18px !important;

        line-height: 1.6 !important;

        text-align: center !important;

        text-shadow:
            0 2px 7px rgba(0,0,0,.45) !important;
    }


    /* ---------- HERO BUTTONS ---------- */

    #home.hero .hero-buttons {
        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        gap: 18px !important;

        margin: 0 auto !important;
    }


    #home.hero .hero-buttons a,
    #home.hero .hero-buttons button {
        min-width: 190px !important;

        min-height: 56px !important;

        padding: 0 25px !important;

        border-radius: 11px !important;

        box-sizing: border-box !important;
    }


    /* ========================================================
       NAVBAR ENTRANCE
       ======================================================== */

    header {
        animation:
            jjFinalNavbarIn
            .5s
            cubic-bezier(.22,1,.36,1)
            both !important;
    }


    @keyframes jjFinalNavbarIn {

        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

}


