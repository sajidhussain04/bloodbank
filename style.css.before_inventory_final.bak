                #dc2626 100%
            ) !important;

        border: 1px solid rgba(255,255,255,.08) !important;

        box-shadow:
            0 10px 26px rgba(220,38,38,.30) !important;
    }


    #home.hero .btn.primary::before,
    #home.hero .btn:not(.secondary):not(.outline)::before {

        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: -120% !important;

        width: 80% !important;
        height: 100% !important;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.22),
                transparent
            ) !important;

        transform: skewX(-20deg) !important;

        transition: left .65s ease !important;
    }


    #home.hero .btn.primary:hover,
    #home.hero .btn:not(.secondary):not(.outline):hover {

        transform: translateY(-4px) !important;

        box-shadow:
            0 17px 35px rgba(220,38,38,.40) !important;

        filter: brightness(1.04) !important;
    }


    #home.hero .btn.primary:hover::before,
    #home.hero .btn:not(.secondary):not(.outline):hover::before {

        left: 140% !important;
    }


    /* ------------------------------------------------------
       SECONDARY BUTTON
       ------------------------------------------------------ */

    #home.hero .btn.secondary,
    #home.hero .btn.outline {

        color: #ffffff !important;

        background:
            rgba(255,255,255,.08) !important;

        border:
            2px solid rgba(255,255,255,.86) !important;

        backdrop-filter: blur(7px) !important;
        -webkit-backdrop-filter: blur(7px) !important;

        box-shadow:
            0 8px 22px rgba(0,0,0,.14) !important;
    }


    #home.hero .btn.secondary:hover,
    #home.hero .btn.outline:hover {

        color: #ffffff !important;

        background:
            rgba(255,255,255,.18) !important;

        border-color:
            #ffffff !important;

        transform:
            translateY(-4px) !important;

        box-shadow:
            0 16px 30px rgba(0,0,0,.25) !important;
    }


    /* ------------------------------------------------------
       KEYFRAMES
       ------------------------------------------------------ */

    @keyframes heroContentReveal {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @keyframes heroEyebrowReveal {

        from {
            opacity: 0;
            transform: translateY(10px);
            letter-spacing: 7px;
        }

        to {
            opacity: 1;
            transform: translateY(0);
            letter-spacing: 4.5px;
        }
    }


    @keyframes heroTitleReveal {

        from {
            opacity: 0;
            transform: translateY(20px) scale(.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    @keyframes heroTextReveal {

        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @keyframes heroButtonsReveal {

        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ------------------------------------------------------
       REDUCED MOTION
       ------------------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        #home.hero *,
        #home.hero::after {

            animation: none !important;
            transition: none !important;
        }
    }
}


/* ============================================================
   JHARJEEVAN — FINAL 10/10 DESKTOP HOME POLISH
   Desktop only — MOBILE IS NOT TOUCHED
   ============================================================ */

@media screen and (min-width: 769px) {

    /* --------------------------------------------------------
       LOGO — NEVER UNDERLINE
       -------------------------------------------------------- */

    header .header-inner > a.logo,
    header .header-inner > a.logo.logo-link,
    header .header-inner > a.logo:visited,
    header .header-inner > a.logo:hover,
    header .header-inner > a.logo:active,
    header .header-inner > a.logo:focus {
        text-decoration: none !important;
        border-bottom: none !important;
        outline: none !important;
    }

    header .header-inner > a.logo h1,
    header .header-inner > a.logo .tagline {
        text-decoration: none !important;
    }


    /* --------------------------------------------------------
       HERO — PREMIUM DESKTOP PRESENTATION
       -------------------------------------------------------- */

    #home.hero {
        position: relative !important;

        height: 500px !important;
        min-height: 500px !important;

        overflow: hidden !important;

        isolation: isolate !important;
    }


    /* Premium readability overlay */

    #home.hero::after {
        content: "" !important;

        position: absolute !important;
        inset: 0 !important;

        z-index: 1 !important;

        pointer-events: none !important;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.24) 0%,
                rgba(0,0,0,.08) 45%,
                rgba(0,0,0,.18) 100%
            ),
            linear-gradient(
                180deg,
                rgba(0,0,0,.08) 0%,
                rgba(0,0,0,.03) 48%,
                rgba(0,0,0,.25) 100%
            ) !important;
    }


    /* --------------------------------------------------------
       HERO CONTENT
       -------------------------------------------------------- */

    #home.hero .hero-content {
        position: relative !important;

        z-index: 3 !important;

        width: min(1050px, calc(100% - 80px)) !important;

        max-width: 1050px !important;

        margin: 0 auto !important;

        text-align: center !important;

        transform: translateY(-2px) !important;
    }


    /* --------------------------------------------------------
       HERO EYEBROW
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-eyebrow,
    #home.hero .hero-content .eyebrow,
    #home.hero .hero-content .hero-label {
        animation: jharHeroFadeUp .7s ease both !important;
    }


    /* --------------------------------------------------------
       MAIN HEADLINE
       -------------------------------------------------------- */

    #home.hero .hero-content h2 {
        position: relative !important;

        z-index: 4 !important;

        margin: 0 auto 18px !important;

        max-width: 1000px !important;

        text-align: center !important;

        letter-spacing: -1.8px !important;

        line-height: 1.04 !important;

        text-shadow:
            0 3px 10px rgba(0,0,0,.38),
            0 8px 28px rgba(0,0,0,.20) !important;

        animation:
            jharHeroFadeUp .8s .08s ease both !important;
    }


    /* --------------------------------------------------------
       HERO DESCRIPTION
       -------------------------------------------------------- */

    #home.hero .hero-content p {
        position: relative !important;

        z-index: 4 !important;

        max-width: 760px !important;

        margin: 0 auto 28px !important;

        text-align: center !important;

        line-height: 1.65 !important;

        text-shadow:
            0 2px 7px rgba(0,0,0,.42) !important;

        animation:
            jharHeroFadeUp .8s .16s ease both !important;
    }


    /* --------------------------------------------------------
       CTA AREA
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-actions,
    #home.hero .hero-content .hero-buttons,
    #home.hero .hero-content .cta-buttons {
        position: relative !important;

        z-index: 5 !important;

        display: flex !important;

        align-items: center !important;

        justify-content: center !important;

        gap: 20px !important;

        margin-top: 4px !important;

        animation:
            jharHeroFadeUp .8s .24s ease both !important;
    }


    /* --------------------------------------------------------
       ALL HERO BUTTONS
       -------------------------------------------------------- */

    #home.hero .hero-content a,
    #home.hero .hero-content button {
        position: relative !important;

        overflow: hidden !important;

        transition:
            transform .25s cubic-bezier(.2,.8,.2,1),
            box-shadow .25s ease,
            background .25s ease,
            border-color .25s ease !important;

        will-change: transform !important;
    }


    /* Shine sweep */

    #home.hero .hero-content a::before,
    #home.hero .hero-content button::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: -120% !important;

        width: 65% !important;
        height: 100% !important;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.24),
                transparent
            ) !important;

        transform: skewX(-20deg) !important;

        transition: left .55s ease !important;

        pointer-events: none !important;
    }


    #home.hero .hero-content a:hover::before,
    #home.hero .hero-content button:hover::before {
        left: 140% !important;
    }


    /* --------------------------------------------------------
       PRIMARY CTA
       -------------------------------------------------------- */

    #home.hero .hero-content a.btn-primary,
    #home.hero .hero-content a.primary,
    #home.hero .hero-content button.btn-primary {
        box-shadow:
            0 10px 26px rgba(220,38,38,.28) !important;
    }


    #home.hero .hero-content a.btn-primary:hover,
    #home.hero .hero-content a.primary:hover,
    #home.hero .hero-content button.btn-primary:hover {
        transform: translateY(-4px) scale(1.015) !important;

        box-shadow:
            0 16px 34px rgba(220,38,38,.38) !important;
    }


    #home.hero .hero-content a.btn-primary:active,
    #home.hero .hero-content a.primary:active,
    #home.hero .hero-content button.btn-primary:active {
        transform: translateY(-1px) scale(.99) !important;
    }


    /* --------------------------------------------------------
       SECONDARY CTA
       -------------------------------------------------------- */

    #home.hero .hero-content a.btn-secondary,
    #home.hero .hero-content a.secondary,
    #home.hero .hero-content button.btn-secondary {
        backdrop-filter: blur(4px) !important;

        -webkit-backdrop-filter: blur(4px) !important;
    }


    #home.hero .hero-content a.btn-secondary:hover,
    #home.hero .hero-content a.secondary:hover,
    #home.hero .hero-content button.btn-secondary:hover {
        transform: translateY(-4px) !important;

        background: rgba(255,255,255,.16) !important;

        border-color: rgba(255,255,255,.95) !important;

        box-shadow:
            0 14px 30px rgba(0,0,0,.20) !important;
    }


    #home.hero .hero-content a.btn-secondary:active,
    #home.hero .hero-content a.secondary:active,
    #home.hero .hero-content button.btn-secondary:active {
        transform: translateY(-1px) !important;
    }


    /* --------------------------------------------------------
       HERO IMAGE — SUBTLE PREMIUM MOTION
       -------------------------------------------------------- */

    #home.hero > img,
    #home.hero .hero-bg,
    #home.hero .hero-background {
        transition: transform 1.2s cubic-bezier(.2,.7,.2,1) !important;
    }


    #home.hero:hover > img,
    #home.hero:hover .hero-bg,
    #home.hero:hover .hero-background {
        transform: scale(1.018) !important;
    }


    /* --------------------------------------------------------
       ABOUT SECTION TRANSITION
       -------------------------------------------------------- */

    #about {
        position: relative !important;
    }


    #about::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 50% !important;

        width: 180px !important;
        height: 1px !important;

        transform: translateX(-50%) !important;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(220,38,38,.25),
                transparent
            ) !important;

        pointer-events: none !important;
    }


    /* --------------------------------------------------------
       PREMIUM HERO ENTRANCE
       -------------------------------------------------------- */

    @keyframes jharHeroFadeUp {

        from {
            opacity: 0;

            transform:
                translateY(18px);
        }

        to {
            opacity: 1;

            transform:
                translateY(0);
        }
    }


    /* --------------------------------------------------------
       ACCESSIBILITY
       -------------------------------------------------------- */

    @media (prefers-reduced-motion: reduce) {

        #home.hero .hero-content *,
        #home.hero .hero-content,
        #home.hero > img,
        #home.hero .hero-bg,
        #home.hero .hero-background {
            animation: none !important;
            transition: none !important;
        }

    }

}


/* ============================================================
   JHARJEEVAN — FINAL MOBILE HOME / HERO
   MOBILE ONLY — DESKTOP COMPLETELY UNTOUCHED
   ============================================================ */

@media screen and (max-width: 768px) {

    /* --------------------------------------------------------
       MOBILE PAGE SAFETY
       -------------------------------------------------------- */

    html,
    body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }


    /* --------------------------------------------------------
       HOME HERO
       -------------------------------------------------------- */

    #home.hero {
        position: relative !important;

        width: 100% !important;
        min-width: 100% !important;

        min-height: 610px !important;
        height: auto !important;

        overflow: hidden !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        isolation: isolate !important;
    }


    /* Premium mobile overlay */

    #home.hero::after {
        content: "" !important;

        position: absolute !important;
        inset: 0 !important;

        z-index: 1 !important;

        pointer-events: none !important;

        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,.18) 0%,
                rgba(0,0,0,.10) 38%,
                rgba(0,0,0,.42) 100%
            ) !important;
    }


    /* --------------------------------------------------------
       HERO CONTENT
       -------------------------------------------------------- */

    #home.hero .hero-content {
        position: relative !important;

        z-index: 3 !important;

        width: calc(100% - 40px) !important;

        max-width: 520px !important;

        margin: 0 auto !important;

        padding: 88px 0 72px !important;

        text-align: center !important;

        display: flex !important;

        flex-direction: column !important;

        align-items: center !important;

        justify-content: center !important;

        box-sizing: border-box !important;
    }


    /* --------------------------------------------------------
       HERO SMALL LABEL
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-eyebrow,
    #home.hero .hero-content .eyebrow,
    #home.hero .hero-content .hero-label {
        margin-bottom: 16px !important;

        font-size: 10px !important;

        line-height: 1.4 !important;

        letter-spacing: 3px !important;

        text-align: center !important;
    }


    /* --------------------------------------------------------
       HERO HEADING
       -------------------------------------------------------- */

    #home.hero .hero-content h2 {
        width: 100% !important;

        max-width: 480px !important;

        margin: 0 auto 20px !important;

        padding: 0 !important;

        text-align: center !important;

        font-size: clamp(38px, 10vw, 52px) !important;

        line-height: 1.03 !important;

        letter-spacing: -1.5px !important;

        text-wrap: balance !important;

        text-shadow:
            0 3px 10px rgba(0,0,0,.48),
            0 8px 24px rgba(0,0,0,.24) !important;
    }


    /* --------------------------------------------------------
       DESCRIPTION
       -------------------------------------------------------- */

    #home.hero .hero-content p {
        width: 100% !important;

        max-width: 430px !important;

        margin: 0 auto 30px !important;

        padding: 0 4px !important;

        text-align: center !important;

        font-size: 15px !important;

        line-height: 1.65 !important;

        font-weight: 500 !important;

        text-wrap: balance !important;

        text-shadow:
            0 2px 7px rgba(0,0,0,.48) !important;
    }


    /* --------------------------------------------------------
       CTA CONTAINER
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-actions,
    #home.hero .hero-content .hero-buttons,
    #home.hero .hero-content .cta-buttons {
        width: 100% !important;

        max-width: 360px !important;

        display: flex !important;

        flex-direction: column !important;

        align-items: stretch !important;

        justify-content: center !important;

        gap: 13px !important;

        margin: 0 auto !important;
    }


    /* --------------------------------------------------------
       MOBILE CTA BUTTONS
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-actions a,
    #home.hero .hero-content .hero-buttons a,
    #home.hero .hero-content .cta-buttons a,
    #home.hero .hero-content .hero-actions button,
    #home.hero .hero-content .hero-buttons button,
    #home.hero .hero-content .cta-buttons button {

        width: 100% !important;

        min-width: 0 !important;

        min-height: 54px !important;

        height: 54px !important;

        margin: 0 !important;

        padding: 0 22px !important;

        display: flex !important;

        align-items: center !important;

        justify-content: center !important;

        box-sizing: border-box !important;

        border-radius: 12px !important;

        font-size: 15px !important;

        font-weight: 700 !important;

        line-height: 1 !important;

        -webkit-tap-highlight-color: transparent !important;

        transition:
            transform .22s ease,
            box-shadow .22s ease,
            background .22s ease !important;
    }


    /* Primary mobile CTA */

    #home.hero .hero-content .hero-actions a:first-child,
    #home.hero .hero-content .hero-buttons a:first-child,
    #home.hero .hero-content .cta-buttons a:first-child {

        box-shadow:
            0 10px 26px rgba(220,38,38,.30) !important;
    }


    /* Touch feedback */

    #home.hero .hero-content .hero-actions a:active,
    #home.hero .hero-content .hero-buttons a:active,
    #home.hero .hero-content .cta-buttons a:active,
    #home.hero .hero-content button:active {

        transform: scale(.975) !important;
    }


    /* --------------------------------------------------------
       MOBILE HERO BACKGROUND
       -------------------------------------------------------- */

    #home.hero > img,
    #home.hero .hero-bg,
    #home.hero .hero-background {

        width: 100% !important;

        height: 100% !important;

        object-fit: cover !important;

        object-position: center center !important;

        transition: transform 1s ease !important;
    }


    /* --------------------------------------------------------
       MOBILE HERO IMAGE POSITION
       -------------------------------------------------------- */

    #home.hero:hover > img,
    #home.hero:hover .hero-bg,
    #home.hero:hover .hero-background {

        transform: none !important;
    }


    /* --------------------------------------------------------
       MOBILE HERO ENTRANCE
       -------------------------------------------------------- */

    #home.hero .hero-content {

        animation:
            jharMobileHeroEnter .65s ease-out both !important;
    }


    @keyframes jharMobileHeroEnter {

        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* --------------------------------------------------------
       SMALL PHONES
       -------------------------------------------------------- */

    @media screen and (max-width: 380px) {

        #home.hero {
            min-height: 590px !important;
        }

        #home.hero .hero-content {
            width: calc(100% - 32px) !important;

            padding-top: 78px !important;
            padding-bottom: 62px !important;
        }

        #home.hero .hero-content h2 {
            font-size: 36px !important;

            letter-spacing: -1.2px !important;

            margin-bottom: 18px !important;
        }

        #home.hero .hero-content p {
            font-size: 14px !important;

            line-height: 1.6 !important;

            margin-bottom: 26px !important;
        }

        #home.hero .hero-content .hero-actions,
        #home.hero .hero-content .hero-buttons,
        #home.hero .hero-content .cta-buttons {
            max-width: 100% !important;
        }

        #home.hero .hero-content .hero-actions a,
        #home.hero .hero-content .hero-buttons a,
        #home.hero .hero-content .cta-buttons a {
            height: 52px !important;
            min-height: 52px !important;
        }
    }


    /* --------------------------------------------------------
       LANDSCAPE PHONES
       -------------------------------------------------------- */

    @media screen and (max-width: 900px) and (orientation: landscape) {

        #home.hero {
            min-height: 520px !important;
        }

        #home.hero .hero-content {
            padding-top: 70px !important;
            padding-bottom: 50px !important;
        }

        #home.hero .hero-content h2 {
            font-size: 38px !important;
        }

        #home.hero .hero-content p {
            margin-bottom: 20px !important;
        }

        #home.hero .hero-content .hero-actions,
        #home.hero .hero-content .hero-buttons,
        #home.hero .hero-content .cta-buttons {
            flex-direction: row !important;

            max-width: 440px !important;
        }
    }


    /* --------------------------------------------------------
       ACCESSIBILITY
       -------------------------------------------------------- */

    @media (prefers-reduced-motion: reduce) {

        #home.hero .hero-content {
            animation: none !important;
        }

        #home.hero .hero-content a,
        #home.hero .hero-content button {
            transition: none !important;
        }
    }

}


/* ============================================================
   FINAL MOBILE HOME BALANCE
   ONLY MOBILE — DESKTOP COMPLETELY UNTOUCHED
   ============================================================ */

@media screen and (max-width: 768px) {

    /* --------------------------------------------------------
       1. REDUCE EMPTY SPACE BELOW CTA BUTTONS
       -------------------------------------------------------- */

    #home.hero {
        min-height: 550px !important;
        height: 550px !important;

        overflow: hidden !important;
    }

    #home.hero .hero-content {
        padding-top: 72px !important;
        padding-bottom: 36px !important;

        width: calc(100% - 40px) !important;
    }


    /* --------------------------------------------------------
       2. BETTER MOBILE BACKGROUND POSITION
       Keeps the important hand/arm visible while reducing
       distraction from the lower flower area.
       -------------------------------------------------------- */

    #home.hero {
        background-position: center 62% !important;
        background-size: cover !important;
        background-repeat: no-repeat !important;
    }

    #home.hero > img,
    #home.hero .hero-bg,
    #home.hero .hero-background {
        object-position: center 62% !important;
    }


    /* --------------------------------------------------------
       3. SLIGHTLY STRONGER LOWER GRADIENT
       Gives the CTA area cleaner visual separation.
       -------------------------------------------------------- */

    #home.hero::after {
        background:
            linear-gradient(
                180deg,
                rgba(0,0,0,.16) 0%,
                rgba(0,0,0,.10) 34%,
                rgba(0,0,0,.28) 62%,
                rgba(0,0,0,.52) 100%
            ) !important;
    }


    /* --------------------------------------------------------
       4. KEEP CTA AREA COMPACT
       -------------------------------------------------------- */

    #home.hero .hero-content p {
        margin-bottom: 26px !important;
    }

    #home.hero .hero-content .hero-actions,
    #home.hero .hero-content .hero-buttons,
    #home.hero .hero-content .cta-buttons {
        gap: 12px !important;
    }


    /* --------------------------------------------------------
       5. BUTTONS REMAIN PREMIUM AND EASY TO TAP
       -------------------------------------------------------- */

    #home.hero .hero-content .hero-actions a,
    #home.hero .hero-content .hero-buttons a,
    #home.hero .hero-content .cta-buttons a {
        height: 52px !important;
        min-height: 52px !important;

        border-radius: 12px !important;
    }


    /* --------------------------------------------------------
       SMALL PHONES
       -------------------------------------------------------- */

    @media screen and (max-width: 380px) {

        #home.hero {
            min-height: 535px !important;
            height: 535px !important;
        }

        #home.hero .hero-content {
            padding-top: 66px !important;
            padding-bottom: 30px !important;
        }

        #home.hero .hero-content p {
            margin-bottom: 24px !important;
        }
    }


    /* --------------------------------------------------------
       LANDSCAPE MOBILE
       -------------------------------------------------------- */

    @media screen and (max-width: 900px) and (orientation: landscape) {

        #home.hero {
            min-height: 500px !important;
            height: 500px !important;
        }
    }
}


/* ==========================================================
   JHARJEEVAN — PREMIUM DESKTOP ABOUT SECTION
   Desktop ONLY — mobile styles remain untouched
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ---------- SECTION ---------- */

    #about.about-section {
        position: relative !important;
        overflow: hidden !important;

        padding: 92px 0 105px !important;

        background:
            radial-gradient(
                circle at 0% 18%,
                rgba(239, 68, 68, 0.055),
                transparent 28%
            ),
            radial-gradient(
                circle at 100% 82%,
                rgba(239, 68, 68, 0.035),
                transparent 30%
            ),
            #ffffff !important;
    }

    /* subtle decorative background glow */

    #about.about-section::before {
        content: "" !important;

        position: absolute !important;

        width: 420px !important;
        height: 420px !important;

        left: -250px !important;
        top: 180px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.035) !important;

        filter: blur(12px) !important;

        pointer-events: none !important;
    }

    #about.about-section::after {
        content: "" !important;

        position: absolute !important;

        width: 300px !important;
        height: 300px !important;

        right: -180px !important;
        bottom: 40px !important;

        border-radius: 50% !important;

        background: rgba(220, 38, 38, 0.025) !important;

        filter: blur(10px) !important;

        pointer-events: none !important;
    }


    /* ---------- CONTAINER ---------- */

    #about.about-section > .container {
        position: relative !important;

        z-index: 2 !important;

        width: min(1180px, calc(100% - 64px)) !important;

        max-width: 1180px !important;

        margin: 0 auto !important;

        padding: 0 !important;
    }


    /* ---------- HEADING ---------- */

    #about.about-section > .container > h2 {
        position: relative !important;

        margin: 0 0 58px !important;
        padding: 0 !important;

        text-align: center !important;

        color: #172033 !important;

        font-size: clamp(34px, 3vw, 44px) !important;
        font-weight: 800 !important;

        line-height: 1.12 !important;

        letter-spacing: -1.4px !important;
    }

    #about.about-section > .container > h2::after {
        content: "" !important;

        display: block !important;

        width: 58px !important;
        height: 4px !important;

        margin: 18px auto 0 !important;

        border-radius: 999px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 5px 14px rgba(220, 38, 38, 0.22) !important;

        transform-origin: center !important;

        transition:
            width .35s ease,
            box-shadow .35s ease !important;
    }

    #about.about-section:hover > .container > h2::after {
        width: 78px !important;

        box-shadow:
            0 7px 18px rgba(220, 38, 38, 0.28) !important;
    }


    /* ---------- MAIN TWO-COLUMN LAYOUT ---------- */

    #about.about-section .about-content {
        display: grid !important;

        grid-template-columns:
            minmax(0, 1.02fr)
            minmax(0, .98fr) !important;

        align-items: center !important;

        gap: 54px !important;

        width: 100% !important;

        margin: 0 !important;
    }


    /* ---------- TEXT CARD ---------- */

    #about.about-section .about-text {
        position: relative !important;

        padding: 38px 38px 30px !important;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,1),
                rgba(255,255,255,.94)
            ) !important;

        border: 1px solid rgba(220, 38, 38, 0.12) !important;

        border-radius: 24px !important;

        box-shadow:
            0 18px 45px rgba(15, 23, 42, 0.075),
            0 3px 10px rgba(15, 23, 42, 0.035) !important;

        overflow: hidden !important;

        transition:
            transform .35s ease,
            box-shadow .35s ease,
            border-color .35s ease !important;
    }

    #about.about-section .about-text::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;

        width: 100% !important;
        height: 4px !important;

        background: linear-gradient(
            90deg,
            #ef4444,
            #dc2626,
            #ef4444
        ) !important;
    }

    #about.about-section .about-text::after {
        content: "" !important;

        position: absolute !important;

        width: 170px !important;
        height: 170px !important;

        right: -95px !important;
        top: -95px !important;

        border-radius: 50% !important;

        background: rgba(239, 68, 68, 0.045) !important;

        pointer-events: none !important;
    }

    #about.about-section .about-text:hover {
        transform: translateY(-4px) !important;

        border-color: rgba(220, 38, 38, 0.18) !important;

        box-shadow:
            0 25px 55px rgba(15, 23, 42, 0.10),
            0 8px 18px rgba(220, 38, 38, 0.045) !important;
    }


    /* ---------- PARAGRAPHS ---------- */

    #about.about-section .about-text p {
        position: relative !important;

        z-index: 2 !important;

        margin: 0 0 19px !important;

        color: #52627a !important;

        font-size: 16px !important;

        font-weight: 450 !important;

        line-height: 1.82 !important;

        letter-spacing: .05px !important;
    }

    #about.about-section .about-text p:last-of-type {
        margin-bottom: 28px !important;
    }


    /* ---------- ACHIEVEMENTS ---------- */

    #about.about-section .achievements {
        position: relative !important;

        z-index: 3 !important;

        display: grid !important;

        grid-template-columns:
            repeat(3, minmax(0, 1fr)) !important;

        gap: 12px !important;

        margin: 0 !important;
        padding: 0 !important;

        list-style: none !important;
    }

    #about.about-section .achievements li {
        position: relative !important;

        min-height: 78px !important;

        display: flex !important;

        align-items: center !important;

        gap: 11px !important;

        margin: 0 !important;
        padding: 12px !important;

        border: 1px solid rgba(226, 232, 240, .9) !important;

        border-radius: 16px !important;

        background: rgba(255,255,255,.92) !important;

        color: #334155 !important;

        font-size: 13px !important;
        font-weight: 650 !important;

        line-height: 1.35 !important;

        box-shadow:
            0 7px 18px rgba(15,23,42,.045) !important;

        transition:
            transform .28s ease,
            border-color .28s ease,
            box-shadow .28s ease,
            background .28s ease !important;

        overflow: hidden !important;
    }

    #about.about-section .achievements li::before {
        content: "" !important;

        position: absolute !important;

        width: 48px !important;
        height: 48px !important;

        right: -23px !important;
        top: -23px !important;

        border-radius: 50% !important;

        background: rgba(239,68,68,.07) !important;
    }

    #about.about-section .achievements li:hover {
        transform: translateY(-5px) !important;

        border-color: rgba(239,68,68,.22) !important;

        background: #fff !important;

        box-shadow:
            0 14px 28px rgba(15,23,42,.08),
            0 5px 15px rgba(220,38,38,.07) !important;
    }

    #about.about-section .achievements li i {
        position: relative !important;

        z-index: 2 !important;

        flex: 0 0 40px !important;

        width: 40px !important;
        height: 40px !important;

        display: inline-flex !important;

        align-items: center !important;
        justify-content: center !important;

        border-radius: 12px !important;

        color: #fff !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        font-size: 15px !important;

        box-shadow:
            0 7px 16px rgba(220,38,38,.20) !important;

        transition:
            transform .28s ease,
            box-shadow .28s ease !important;
    }

    #about.about-section .achievements li:hover i {
        transform: scale(1.08) rotate(-3deg) !important;

        box-shadow:
            0 9px 20px rgba(220,38,38,.28) !important;
    }


    /* ---------- IMAGE ---------- */

    #about.about-section .about-image {
        position: relative !important;

        width: 100% !important;

        border-radius: 24px !important;

        overflow: visible !important;

        transform: translateZ(0) !important;
    }

    #about.about-section .about-image::before {
        content: "" !important;

        position: absolute !important;

        inset: -7px !important;

        border-radius: 28px !important;

        border: 1px solid rgba(220,38,38,.10) !important;

        pointer-events: none !important;

        z-index: 0 !important;
    }

    #about.about-section .about-image::after {
        content: "" !important;

        position: absolute !important;

        width: 54px !important;
        height: 54px !important;

        right: -17px !important;
        top: -17px !important;

        border-radius: 50% !important;

        background: linear-gradient(
            135deg,
            #ef4444,
            #dc2626
        ) !important;

        box-shadow:
            0 9px 22px rgba(220,38,38,.22) !important;

        z-index: 3 !important;

        transition:
            transform .35s ease,
            box-shadow .35s ease !important;
    }

    #about.about-section .about-image:hover::after {
        transform: scale(1.08) !important;

        box-shadow:
            0 12px 28px rgba(220,38,38,.30) !important;
    }

    #about.about-section .about-image img {
        position: relative !important;

        z-index: 1 !important;

        display: block !important;

        width: 100% !important;

        height: 390px !important;

        object-fit: cover !important;

        object-position: center !important;

        border-radius: 24px !important;

        border: 4px solid #fff !important;

        box-sizing: border-box !important;

        box-shadow:
            0 22px 48px rgba(15,23,42,.12),
            0 5px 16px rgba(15,23,42,.06) !important;

        transition:
            transform .5s cubic-bezier(.2,.7,.2,1),
            filter .5s ease,
            box-shadow .5s ease !important;
    }

    #about.about-section .about-image:hover img {
        transform: scale(1.018) !important;

        filter: saturate(1.06) contrast(1.015) !important;

        box-shadow:
            0 28px 60px rgba(15,23,42,.16),
            0 8px 20px rgba(220,38,38,.06) !important;
    }


    /* ---------- LARGE DESKTOP BALANCE ---------- */

    @media screen and (min-width: 1200px) {

        #about.about-section .about-content {
            gap: 64px !important;
        }

        #about.about-section .about-text {
            padding: 42px 42px 32px !important;
        }

        #about.about-section .about-text p {
            font-size: 16.5px !important;
        }

        #about.about-section .about-image img {
            height: 410px !important;
        }
    }


    /* ---------- REDUCED MOTION ---------- */

    @media (prefers-reduced-motion: reduce) {

        #about.about-section *,
        #about.about-section *::before,
        #about.about-section *::after {
            transition: none !important;
            animation: none !important;
        }
    }
}


/* ============================================================
   JHARJEEVAN ABOUT SECTION — FINAL 10/10
   Desktop + Mobile refinement
   Navbar and Home are NOT touched
   ============================================================ */


/* ============================================================
   ABOUT BASE
   ============================================================ */

#about {
    position: relative !important;
    overflow: hidden !important;
}

#about .container {
    width: min(1120px, calc(100% - 40px)) !important;
    margin: 0 auto !important;
}


/* ============================================================
   ABOUT HEADING
   ============================================================ */

#about #about-heading {
    margin-top: 0 !important;
    margin-bottom: 42px !important;

    text-align: center !important;

    font-size: clamp(32px, 3vw, 42px) !important;
    line-height: 1.12 !important;
    letter-spacing: -1.2px !important;
}


/* Red heading accent */
#about #about-heading::after {
    content: "" !important;

    display: block !important;

    width: 72px !important;
    height: 4px !important;

    margin: 18px auto 0 !important;

    border-radius: 999px !important;

    background: linear-gradient(
        90deg,
        #ef4444,
        #dc2626
    ) !important;

    box-shadow:
        0 5px 14px rgba(220,38,38,.20) !important;
}


/* ============================================================
   DESKTOP
   ============================================================ */

@media screen and (min-width: 769px) {

    #about {
        padding-top: 72px !important;
        padding-bottom: 86px !important;
    }


    #about .container {
        max-width: 1120px !important;
    }


    /* Content becomes perfectly balanced */
    #about .about-content {
        display: flex !important;
        align-items: stretch !important;
        justify-content: center !important;

        gap: 46px !important;

        width: 100% !important;
        max-width: 1120px !important;

        margin: 0 auto !important;
    }


    /* --------------------------------------------------------
       LEFT TEXT CARD
       -------------------------------------------------------- */

    #about .about-text {
        flex: 1 1 0 !important;

        min-width: 0 !important;
        min-height: 410px !important;

        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;

        box-sizing: border-box !important;

        padding: 38px 38px 30px !important;

        border-radius: 22px !important;

        background:
            linear-gradient(
                145deg,
                rgba(255,255,255,.98),
                rgba(255,255,255,.94)
            ) !important;

        border: 1px solid rgba(220,38,38,.14) !important;

        border-top: 3px solid #ef4444 !important;

        box-shadow:
            0 18px 45px rgba(15,23,42,.08),
