        position: relative !important;

        overflow: hidden !important;

        transition:
            transform .35s ease,
            box-shadow .35s ease !important;
    }


    #about .about-text::before {
        content: "" !important;

        position: absolute !important;

        width: 150px !important;
        height: 150px !important;

        top: -90px !important;
        right: -70px !important;

        border-radius: 50% !important;

        background: rgba(239,68,68,.055) !important;

        pointer-events: none !important;
    }


    #about .about-text:hover {
        transform: translateY(-4px) !important;

        box-shadow:
            0 24px 55px rgba(15,23,42,.11),
            0 8px 22px rgba(220,38,38,.07) !important;
    }


    #about .about-text > p {
        position: relative !important;
        z-index: 1 !important;

        margin-top: 0 !important;
        margin-bottom: 18px !important;

        color: #64748b !important;

        font-size: 16px !important;
        line-height: 1.78 !important;
    }


    #about .about-text > p:last-of-type {
        margin-bottom: 28px !important;
    }


    /* --------------------------------------------------------
       ACHIEVEMENT CARDS
       -------------------------------------------------------- */

    #about .achievements {
        position: relative !important;
        z-index: 2 !important;

        display: grid !important;

        grid-template-columns:
            repeat(3, minmax(0, 1fr)) !important;

        gap: 12px !important;

        width: 100% !important;

        margin: auto 0 0 !important;
        padding: 0 !important;

        list-style: none !important;
    }


    #about .achievements li {
        min-width: 0 !important;
        min-height: 72px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;

        gap: 12px !important;

        padding: 11px 12px !important;

        box-sizing: border-box !important;

        border-radius: 16px !important;

        background:
            linear-gradient(
                145deg,
                #ffffff,
                #f8fafc
            ) !important;

        border: 1px solid #e7eaf0 !important;

        box-shadow:
            0 8px 20px rgba(15,23,42,.055) !important;

        position: relative !important;

        overflow: hidden !important;

        transition:
            transform .28s ease,
            box-shadow .28s ease,
            border-color .28s ease !important;
    }


    #about .achievements li::after {
        content: "" !important;

        position: absolute !important;

        width: 64px !important;
        height: 64px !important;

        top: -30px !important;
        right: -24px !important;

        border-radius: 50% !important;

        background: rgba(239,68,68,.13) !important;

        pointer-events: none !important;
    }


    #about .achievements li:hover {
        transform: translateY(-4px) !important;

        border-color: rgba(220,38,38,.22) !important;

        box-shadow:
            0 14px 28px rgba(15,23,42,.09),
            0 5px 15px rgba(220,38,38,.07) !important;
    }


    #about .achievements li i {
        position: relative !important;
        z-index: 2 !important;

        flex: 0 0 40px !important;

        width: 40px !important;
        height: 40px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        margin: 0 !important;

        border-radius: 12px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef4444,
                #dc2626
            ) !important;

        font-size: 17px !important;

        box-shadow:
            0 7px 16px rgba(220,38,38,.22) !important;

        transition:
            transform .28s ease !important;
    }


    #about .achievements li:hover i {
        transform: scale(1.08) rotate(-3deg) !important;
    }


    #about .achievements li span,
    #about .achievements li strong,
    #about .achievements li b {
        position: relative !important;
        z-index: 2 !important;
    }


    /* --------------------------------------------------------
       RIGHT IMAGE
       -------------------------------------------------------- */

    #about .about-image {
        flex: 1 1 0 !important;

        min-width: 0 !important;
        min-height: 410px !important;

        display: flex !important;
        align-items: stretch !important;

        position: relative !important;

        box-sizing: border-box !important;
    }


    #about .about-image img {
        display: block !important;

        width: 100% !important;
        height: 410px !important;

        min-height: 410px !important;

        object-fit: cover !important;
        object-position: center !important;

        border-radius: 22px !important;

        border: 4px solid #ffffff !important;

        box-shadow:
            0 20px 48px rgba(15,23,42,.14),
            0 6px 18px rgba(15,23,42,.07) !important;

        transition:
            transform .45s cubic-bezier(.22,1,.36,1),
            box-shadow .35s ease !important;
    }


    #about .about-image:hover img {
        transform: scale(1.018) !important;

        box-shadow:
            0 26px 58px rgba(15,23,42,.17),
            0 8px 24px rgba(220,38,38,.08) !important;
    }


    /* Decorative red circle */
    #about .about-image::after {
        content: "" !important;

        position: absolute !important;

        width: 52px !important;
        height: 52px !important;

        top: -20px !important;
        right: -18px !important;

        border-radius: 50% !important;

        background:
            linear-gradient(
                135deg,
                #ef4444,
                #dc2626
            ) !important;

        opacity: .9 !important;

        box-shadow:
            0 10px 24px rgba(220,38,38,.20) !important;

        pointer-events: none !important;

        transition:
            transform .35s ease !important;
    }


    #about .about-image:hover::after {
        transform: scale(1.08) !important;
    }
}


