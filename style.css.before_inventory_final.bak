   ============================================================ */

#home.hero {
    position: relative !important;
    isolation: isolate !important;
    min-height: 560px !important;
    height: 560px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;

    background-image:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.48) 0%,
            rgba(0, 0, 0, 0.38) 48%,
            rgba(0, 0, 0, 0.48) 100%
        ),
        url("image2.jpg") !important;

    background-repeat: no-repeat !important;
    background-size: cover !important;
    background-position: center 42% !important;
}

/* Elegant dark overlay for readability */
#home.hero::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: -1 !important;
    pointer-events: none !important;

    background:
        radial-gradient(
            circle at 50% 48%,
            rgba(255, 255, 255, 0.08),
            transparent 38%
        ),
        linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.08),
            rgba(0, 0, 0, 0.16)
        ) !important;
}

/* Subtle premium red glow */
#home.hero::after {
    content: "" !important;
    position: absolute !important;
    width: 520px !important;
    height: 520px !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    border-radius: 50% !important;
    pointer-events: none !important;
    z-index: -1 !important;

    background: radial-gradient(
        circle,
        rgba(214, 40, 40, 0.10) 0%,
        rgba(214, 40, 40, 0.04) 38%,
        transparent 72%
    ) !important;

    animation: heroGlow 7s ease-in-out infinite !important;
}

#home.hero .hero-content {
    position: relative !important;
    z-index: 2 !important;
    width: min(980px, calc(100% - 40px)) !important;
    margin: 0 auto !important;
    text-align: center !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;

    padding: 30px 20px !important;

    animation: homeHeroEnter 0.9s ease-out both !important;
}

/* Small premium label */
#home.hero .hero-content::before {
    content: "BE A HERO  •  SAVE LIVES" !important;
    display: block !important;
    margin-bottom: 18px !important;

    color: #ff3b3b !important;
    font-size: 13px !important;
    font-weight: 800 !important;
    letter-spacing: 4px !important;
    text-transform: uppercase !important;

    text-shadow: 0 2px 12px rgba(0,0,0,.35) !important;
}

/* Main heading */
#home.hero .hero-content h2 {
    margin: 0 !important;
    max-width: 900px !important;

    color: #ffffff !important;
    font-size: clamp(42px, 5vw, 68px) !important;
    line-height: 1.05 !important;
    font-weight: 900 !important;
    letter-spacing: -1.5px !important;

    text-shadow:
        0 3px 10px rgba(0,0,0,.55),
        0 8px 28px rgba(0,0,0,.28) !important;

    animation: heroHeadingIn 0.9s 0.12s ease-out both !important;
}

/* Description */
#home.hero .hero-content p {
    max-width: 850px !important;
    margin: 22px auto 0 !important;

    color: rgba(255,255,255,.96) !important;
    font-size: clamp(16px, 1.5vw, 19px) !important;
    line-height: 1.65 !important;
    font-weight: 500 !important;

    text-shadow: 0 2px 8px rgba(0,0,0,.55) !important;

    animation: heroTextIn 0.9s 0.25s ease-out both !important;
}

/* Button row */
#home.hero .hero-content .hero-buttons,
#home.hero .hero-content .buttons,
#home.hero .hero-content > div:last-child {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 14px !important;
    flex-wrap: wrap !important;

    margin-top: 30px !important;

    animation: heroButtonsIn 0.9s 0.38s ease-out both !important;
}

/* Buttons */
#home.hero .hero-content .btn,
#home.hero .hero-content a.btn {
    min-width: 190px !important;
    min-height: 56px !important;
    padding: 15px 28px !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 11px !important;
    font-size: 15px !important;
    font-weight: 800 !important;
    letter-spacing: .1px !important;

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        background .25s ease,
        border-color .25s ease !important;
}

/* Primary */
#home.hero .hero-content .btn.primary,
#home.hero .hero-content a.primary {
    color: #ffffff !important;
    background: linear-gradient(
        135deg,
        #ef3038 0%,
        #d62828 100%
    ) !important;

    border: 1px solid rgba(255,255,255,.10) !important;

    box-shadow:
        0 12px 28px rgba(214,40,40,.32),
        0 4px 10px rgba(0,0,0,.16) !important;
}

#home.hero .hero-content .btn.primary:hover,
#home.hero .hero-content a.primary:hover {
    transform: translateY(-4px) !important;

    box-shadow:
        0 18px 34px rgba(214,40,40,.40),
        0 7px 14px rgba(0,0,0,.18) !important;
}

/* Secondary */
#home.hero .hero-content .btn.secondary,
#home.hero .hero-content a.secondary {
    color: #ffffff !important;
    background: rgba(255,255,255,.08) !important;
    border: 2px solid rgba(255,255,255,.88) !important;

    backdrop-filter: blur(5px) !important;
    -webkit-backdrop-filter: blur(5px) !important;
}

#home.hero .hero-content .btn.secondary:hover,
#home.hero .hero-content a.secondary:hover {
    color: #ffffff !important;
    background: rgba(255,255,255,.18) !important;
    border-color: #ffffff !important;

    transform: translateY(-4px) !important;

    box-shadow:
        0 14px 28px rgba(0,0,0,.20) !important;
}

/* Entrance animations */
@keyframes homeHeroEnter {
    from {
        opacity: 0;
        transform: translateY(22px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes heroHeadingIn {
    from {
        opacity: 0;
        transform: translateY(18px) scale(.97);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes heroTextIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes heroButtonsIn {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes heroGlow {
    0%, 100% {
        opacity: .55;
        transform: translate(-50%, -50%) scale(1);
    }

    50% {
        opacity: .9;
        transform: translate(-50%, -50%) scale(1.08);
    }
}

