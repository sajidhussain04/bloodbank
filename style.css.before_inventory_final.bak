            color .25s ease,
            transform .3s cubic-bezier(.22,1,.36,1) !important;
    }

    header .header-inner > a.logo.logo-link:hover h1 {
        color: #c91f1f !important;
        transform: translateX(1px) !important;
    }


    /* ======================================================
       NAVIGATION LINKS
       ====================================================== */

    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn) {
        position: relative !important;

        overflow: hidden !important;

        color: #334155 !important;

        background: transparent !important;

        transition:
            color .25s ease,
            background-color .25s ease,
            transform .25s cubic-bezier(.22,1,.36,1),
            box-shadow .25s ease !important;
    }


    /* Premium hover background */

    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover {
        color: #dc2626 !important;

        background:
            linear-gradient(
                135deg,
                rgba(220,38,38,.065),
                rgba(220,38,38,.025)
            ) !important;

        transform: translateY(-2px) !important;

        box-shadow:
            0 5px 14px rgba(220,38,38,.07) !important;
    }


    /* Animated red underline */

    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn)::after {
        content: "" !important;

        position: absolute !important;

        left: 50% !important;
        bottom: 3px !important;

        width: 0 !important;
        height: 2px !important;

        border-radius: 999px !important;

        background:
            linear-gradient(
                90deg,
                #ef4444,
                #dc2626
            ) !important;

        transform:
            translateX(-50%)
            scaleX(.7) !important;

        transform-origin: center !important;

        opacity: 0 !important;

        transition:
            width .32s cubic-bezier(.22,1,.36,1),
            transform .32s cubic-bezier(.22,1,.36,1),
            opacity .2s ease !important;
    }


    header .header-inner > nav > #mainNav > li > a:not(.admin-login-btn):hover::after {
        width: 28px !important;

        opacity: 1 !important;

        transform:
            translateX(-50%)
            scaleX(1) !important;
    }


    /* ======================================================
       LOGIN — PREMIUM BUTTON
       ====================================================== */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn {
        position: relative !important;

        overflow: hidden !important;

        min-width: 84px !important;
        height: 42px !important;

        margin-left: 12px !important;
        padding: 0 20px !important;

        border: 0 !important;
        border-radius: 11px !important;

        color: #fff !important;

        background:
            linear-gradient(
                135deg,
                #f04444 0%,
                #dc2626 55%,
                #c91f1f 100%
            ) !important;

        box-shadow:
            0 7px 18px rgba(220,38,38,.23),
            0 1px 2px rgba(127,29,29,.15) !important;

        font-weight: 750 !important;

        transition:
            transform .3s cubic-bezier(.22,1,.36,1),
            box-shadow .3s ease,
            filter .3s ease !important;
    }


    /* Login shine */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn::before {
        content: "" !important;

        position: absolute !important;

        top: -20% !important;
        left: -120% !important;

        width: 65% !important;
        height: 140% !important;

        background:
            linear-gradient(
                105deg,
                transparent 0%,
                rgba(255,255,255,.08) 35%,
                rgba(255,255,255,.42) 50%,
                rgba(255,255,255,.08) 65%,
                transparent 100%
            ) !important;

        transform: skewX(-18deg) !important;

        transition: left .65s cubic-bezier(.22,1,.36,1) !important;

        pointer-events: none !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover {
        color: #fff !important;

        transform:
            translateY(-2px)
            scale(1.015) !important;

        filter: brightness(1.04) !important;

        box-shadow:
            0 12px 28px rgba(220,38,38,.31),
            0 3px 8px rgba(127,29,29,.12) !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover::before {
        left: 145% !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:active {
        transform:
            translateY(0)
            scale(.97) !important;

        box-shadow:
            0 5px 12px rgba(220,38,38,.20) !important;
    }


    /* ======================================================
       KEYBOARD ACCESSIBILITY
       ====================================================== */

    header .header-inner > nav > #mainNav > li > a:focus-visible {
        outline: 3px solid rgba(220,38,38,.18) !important;
        outline-offset: 3px !important;
    }

    header .header-inner > a.logo.logo-link:focus-visible {
        outline: 3px solid rgba(220,38,38,.18) !important;
        outline-offset: 4px !important;
        border-radius: 6px !important;
    }


    /* ======================================================
       REDUCED MOTION
       ====================================================== */

    @media (prefers-reduced-motion: reduce) {

        header,
        header *,
        header *::before,
        header *::after {
            animation: none !important;
            transition: none !important;
        }
    }
}


/* ==========================================================
   PREMIUM NAVBAR HOVER INTERACTIONS
   DESKTOP ONLY — MOBILE UNTOUCHED
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ------------------------------------------
       NAV LINK BASE
       ------------------------------------------ */

    header .header-inner nav #mainNav li a:not(.admin-login-btn) {
        position: relative !important;
        overflow: hidden !important;

        transition:
            color .28s ease,
            background-color .28s ease,
            transform .28s cubic-bezier(.22,1,.36,1),
            box-shadow .28s ease !important;
    }


    /* ------------------------------------------
       PREMIUM HOVER BACKGROUND
       ------------------------------------------ */

    header .header-inner nav #mainNav li a:not(.admin-login-btn):hover {
        color: #dc2626 !important;

        background:
            linear-gradient(
                135deg,
                rgba(220,38,38,.075),
                rgba(220,38,38,.025)
            ) !important;

        transform: translateY(-2px) !important;

        box-shadow:
            0 6px 16px rgba(220,38,38,.08) !important;
    }


    /* ------------------------------------------
       ANIMATED RED UNDERLINE
       ------------------------------------------ */

    header .header-inner nav #mainNav li a:not(.admin-login-btn)::after {
        content: "" !important;

        position: absolute !important;

        left: 50% !important;
        bottom: 4px !important;

        width: 0 !important;
        height: 2px !important;

        border-radius: 999px !important;

        background:
            linear-gradient(
                90deg,
                #ef4444 0%,
                #dc2626 50%,
                #b91c1c 100%
            ) !important;

        transform: translateX(-50%) !important;

        opacity: 0 !important;

        box-shadow:
            0 0 8px rgba(220,38,38,.25) !important;

        transition:
            width .32s cubic-bezier(.22,1,.36,1),
            opacity .22s ease !important;
    }


    header .header-inner nav #mainNav li a:not(.admin-login-btn):hover::after {
        width: 30px !important;
        opacity: 1 !important;
    }


    /* ------------------------------------------
       LINK CLICK FEEDBACK
       ------------------------------------------ */

    header .header-inner nav #mainNav li a:not(.admin-login-btn):active {
        transform: translateY(0) scale(.97) !important;
    }


    /* ------------------------------------------
       LOGIN BUTTON
       ------------------------------------------ */

    header .header-inner nav #mainNav li a.admin-login-btn {
        position: relative !important;
        overflow: hidden !important;

        transition:
            transform .28s cubic-bezier(.22,1,.36,1),
            box-shadow .28s ease,
            filter .28s ease !important;
    }


    /* Login hover glow */

    header .header-inner nav #mainNav li a.admin-login-btn:hover {
        transform:
            translateY(-3px)
            scale(1.02) !important;

        filter: brightness(1.05) !important;

        box-shadow:
            0 12px 28px rgba(220,38,38,.32),
            0 0 0 4px rgba(220,38,38,.06) !important;
    }


    /* ------------------------------------------
       LOGIN SHINE EFFECT
       ------------------------------------------ */

    header .header-inner nav #mainNav li a.admin-login-btn::before {
        content: "" !important;

        position: absolute !important;

        top: -40% !important;
        left: -130% !important;

        width: 65% !important;
        height: 180% !important;

        background:
            linear-gradient(
                105deg,
                transparent 0%,
                rgba(255,255,255,.08) 35%,
                rgba(255,255,255,.50) 50%,
                rgba(255,255,255,.08) 65%,
                transparent 100%
            ) !important;

        transform: skewX(-20deg) !important;

        pointer-events: none !important;

        transition:
            left .7s cubic-bezier(.22,1,.36,1) !important;
    }


    header .header-inner nav #mainNav li a.admin-login-btn:hover::before {
        left: 145% !important;
    }


    /* ------------------------------------------
       LOGIN CLICK
       ------------------------------------------ */

    header .header-inner nav #mainNav li a.admin-login-btn:active {
        transform:
            translateY(0)
            scale(.96) !important;

        box-shadow:
            0 5px 12px rgba(220,38,38,.20) !important;
    }


    /* ------------------------------------------
       LOGO HOVER
       ------------------------------------------ */

    header .header-inner > a.logo.logo-link {
        transition:
            transform .3s cubic-bezier(.22,1,.36,1),
            opacity .25s ease !important;
    }


    header .header-inner > a.logo.logo-link:hover {
        transform: translateY(-1px) !important;
        opacity: .94 !important;
    }


    header .header-inner > a.logo.logo-link:hover h1 {
        color: #c91f1f !important;
    }


    /* ------------------------------------------
       KEYBOARD ACCESSIBILITY
       ------------------------------------------ */

    header .header-inner nav #mainNav li a:focus-visible {
        outline:
            3px solid rgba(220,38,38,.20) !important;

        outline-offset: 3px !important;
    }


    /* ------------------------------------------
       REDUCED MOTION
       ------------------------------------------ */

    @media (prefers-reduced-motion: reduce) {

        header,
        header *,
        header *::before,
        header *::after {
            animation: none !important;
            transition: none !important;
        }
    }
}


/* ==========================================================
   JHARJEEVAN — FINAL MOBILE NAVBAR
   ONLY MAX-WIDTH 768px
   DESKTOP IS COMPLETELY UNTOUCHED
   ========================================================== */

@media screen and (max-width: 768px) {

    /* ======================================================
       MOBILE HEADER
       ====================================================== */

    header {
        position: sticky !important;
        top: 0 !important;
        left: 0 !important;

        width: 100% !important;
        height: 62px !important;

        background:
            rgba(255,255,255,.97) !important;

        border-bottom:
            1px solid rgba(15,23,42,.07) !important;

        box-shadow:
            0 5px 20px rgba(15,23,42,.09) !important;

        backdrop-filter:
            blur(16px) saturate(140%) !important;

        -webkit-backdrop-filter:
            blur(16px) saturate(140%) !important;

        z-index: 99999 !important;

        transition:
            box-shadow .25s ease,
            background .25s ease !important;
    }


    /* ======================================================
       HEADER INNER
       ====================================================== */

    header .header-inner {
        width: 100% !important;
        height: 62px !important;

        margin: 0 !important;

        padding:
            0 16px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;

        box-sizing: border-box !important;

        overflow: visible !important;
    }


    /* ======================================================
       LOGO
       ====================================================== */

    header .header-inner > a.logo,
    header .header-inner > a.logo.logo-link {
        display: flex !important;

        flex-direction: column !important;
        align-items: flex-start !important;
        justify-content: center !important;

        width: auto !important;
        min-width: 0 !important;
        max-width: calc(100% - 58px) !important;

        height: 62px !important;

        margin: 0 !important;
        padding: 0 !important;

        flex: 0 1 auto !important;

        position: relative !important;

        color: #dc2626 !important;

        text-decoration: none !important;
        border: 0 !important;

        overflow: visible !important;

        transform: none !important;

        transition:
            opacity .25s ease,
            transform .25s cubic-bezier(.22,1,.36,1) !important;
    }


    /* Completely remove old desktop logo effects */

    header .header-inner > a.logo::before,
    header .header-inner > a.logo::after,
    header .header-inner > a.logo.logo-link::before,
    header .header-inner > a.logo.logo-link::after,
    header .header-inner > a.logo h1::before,
    header .header-inner > a.logo h1::after {
        content: none !important;

        display: none !important;

        width: 0 !important;
        height: 0 !important;

        border: 0 !important;
        background: none !important;
        box-shadow: none !important;
    }


    header .header-inner > a.logo:hover {
        transform: translateX(1px) !important;
        opacity: .94 !important;
    }


    /* Logo name */

    header .header-inner > a.logo h1 {
        display: block !important;

        width: auto !important;
        height: auto !important;

        margin: 0 !important;
        padding: 0 !important;

        color: #dc2626 !important;

        font-size: 21px !important;
        font-weight: 800 !important;

        line-height: 1 !important;

        letter-spacing: -.45px !important;

        white-space: nowrap !important;

        text-decoration: none !important;
        border: 0 !important;
    }


    /* Logo tagline */

    header .header-inner > a.logo .tagline {
        display: block !important;

        width: auto !important;

        margin: 3px 0 0 !important;
        padding: 0 !important;

        color: #64748b !important;

        font-size: 9px !important;
        font-weight: 500 !important;

        line-height: 1 !important;

        letter-spacing: 0 !important;

        white-space: nowrap !important;

        text-decoration: none !important;
    }


    /* ======================================================
       MOBILE NAV CONTAINER
       ====================================================== */

    header .header-inner > nav {
        display: flex !important;

        align-items: center !important;
        justify-content: flex-end !important;

        width: auto !important;
        min-width: 0 !important;

        height: 62px !important;

        margin: 0 !important;
        padding: 0 !important;

        flex: 0 0 auto !important;

        overflow: visible !important;
    }


    /* ======================================================
       HAMBURGER BUTTON
       ====================================================== */

    header .header-inner > nav > .mobile-menu,
    header .mobile-menu {
        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        position: relative !important;

        width: 42px !important;
        height: 42px !important;

        margin: 0 !important;
        padding: 0 !important;

        border: 0 !important;
        border-radius: 12px !important;

        color: #1e293b !important;

        background:
            rgba(220,38,38,.055) !important;

        box-shadow:
            0 4px 12px rgba(220,38,38,.08) !important;

        cursor: pointer !important;

        transition:
            background .25s ease,
            color .25s ease,
            transform .25s cubic-bezier(.22,1,.36,1),
            box-shadow .25s ease !important;

        -webkit-tap-highlight-color: transparent !important;
    }


    header .header-inner > nav > .mobile-menu:hover,
    header .mobile-menu:hover {
        color: #dc2626 !important;

        background:
            rgba(220,38,38,.10) !important;

        transform:
            translateY(-1px) !important;

        box-shadow:
            0 7px 17px rgba(220,38,38,.13) !important;
    }


    header .header-inner > nav > .mobile-menu:active,
    header .mobile-menu:active {
        transform:
            scale(.92) !important;

        box-shadow:
            0 3px 8px rgba(220,38,38,.10) !important;
    }


    header .header-inner > nav > .mobile-menu:focus-visible,
    header .mobile-menu:focus-visible {
        outline:
            3px solid rgba(220,38,38,.18) !important;

        outline-offset: 2px !important;
    }


    /* ======================================================
       HAMBURGER ICON
       ====================================================== */

    header .mobile-menu i,
    header .mobile-menu svg {
        font-size: 21px !important;

        width: 21px !important;
        height: 21px !important;

        transition:
            transform .3s cubic-bezier(.22,1,.36,1),
            color .25s ease !important;
    }


    header .mobile-menu:hover i,
    header .mobile-menu:hover svg {
        color: #dc2626 !important;
    }


    /* ======================================================
       MOBILE MENU LIST
       ====================================================== */

    header .header-inner > nav > #mainNav {
        position: absolute !important;

        top: 62px !important;
        left: 12px !important;
        right: 12px !important;

        width: auto !important;
        height: auto !important;

        margin: 0 !important;
        padding: 8px !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;

        gap: 3px !important;

        list-style: none !important;

        background:
            rgba(255,255,255,.985) !important;

        border:
            1px solid rgba(15,23,42,.07) !important;

        border-radius: 16px !important;

        box-shadow:
            0 18px 45px rgba(15,23,42,.14),
            0 4px 12px rgba(15,23,42,.06) !important;

        backdrop-filter:
            blur(18px) !important;

        -webkit-backdrop-filter:
            blur(18px) !important;

        overflow: hidden !important;

        /* Closed state */

        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;

        transform:
            translateY(-10px)
            scale(.98) !important;

        transform-origin:
            top center !important;

        transition:
            opacity .25s ease,
            visibility .25s ease,
            transform .3s cubic-bezier(.22,1,.36,1) !important;
    }


    /* ======================================================
       OPEN MENU
       Supports common existing JS classes
       ====================================================== */

    header .header-inner > nav > #mainNav.active,
    header .header-inner > nav > #mainNav.open,
    header .header-inner > nav > #mainNav.show,
    header .header-inner > nav > #mainNav.mobile-open,
    header .header-inner > nav > #mainNav.menu-open,
    header .header-inner > nav > #mainNav.visible {
        opacity: 1 !important;

        visibility: visible !important;

        pointer-events: auto !important;

        transform:
            translateY(0)
            scale(1) !important;
    }


    /* ======================================================
       MOBILE MENU ITEMS
       ====================================================== */

    header .header-inner > nav > #mainNav > li {
        display: block !important;

        width: 100% !important;
        height: auto !important;

        margin: 0 !important;
        padding: 0 !important;
    }


    header .header-inner > nav > #mainNav > li > a {
        display: flex !important;

        align-items: center !important;
        justify-content: flex-start !important;

        width: 100% !important;
        min-height: 46px !important;

        margin: 0 !important;
        padding:
            0 14px !important;

        box-sizing: border-box !important;

        border-radius: 11px !important;

        color: #334155 !important;

        background: transparent !important;

        font-size: 14px !important;
        font-weight: 600 !important;

        line-height: 1 !important;

        text-decoration: none !important;

        transform: translateX(0) !important;

        transition:
            color .2s ease,
            background .2s ease,
            transform .22s cubic-bezier(.22,1,.36,1) !important;
    }


    header .header-inner > nav > #mainNav > li > a:hover {
        color: #dc2626 !important;

        background:
            rgba(220,38,38,.065) !important;

        transform:
            translateX(4px) !important;
    }


    header .header-inner > nav > #mainNav > li > a:active {
        transform:
            translateX(2px)
            scale(.985) !important;
    }


    /* Remove desktop underline animation from mobile links */

    header .header-inner > nav > #mainNav > li > a::after {
        display: none !important;
        content: none !important;
    }


    /* ======================================================
       MOBILE LOGIN
       ====================================================== */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn {
        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        width: 100% !important;
        min-height: 44px !important;

        margin:
            5px 0 2px !important;

        padding: 0 16px !important;

        border-radius: 11px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef4444,
                #dc2626
            ) !important;

        box-shadow:
            0 7px 17px rgba(220,38,38,.20) !important;

        font-weight: 700 !important;

        transform: none !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover {
        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #f04444,
                #c91f1f
            ) !important;

        transform:
            translateY(-1px) !important;

        box-shadow:
            0 10px 22px rgba(220,38,38,.27) !important;
    }


    /* ======================================================
       REDUCED MOTION
       ====================================================== */

    @media (prefers-reduced-motion: reduce) {

        header,
        header *,
        header *::before,
        header *::after {
            transition: none !important;
            animation: none !important;
        }
    }
}


