        list-style: none !important;

        background:
            rgba(255,255,255,.985) !important;

        border:
            1px solid rgba(15,23,42,.07) !important;

        border-radius: 16px !important;

        box-shadow:
            0 18px 45px rgba(15,23,42,.14),
            0 4px 12px rgba(15,23,42,.06) !important;

        backdrop-filter:
            blur(18px) !important;

        -webkit-backdrop-filter:
            blur(18px) !important;

        overflow: hidden !important;

        /* Closed state */

        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;

        transform:
            translateY(-10px)
            scale(.98) !important;

        transform-origin:
            top center !important;

        transition:
            opacity .25s ease,
            visibility .25s ease,
            transform .3s cubic-bezier(.22,1,.36,1) !important;
    }


    /* ======================================================
       OPEN MENU
       Supports common existing JS classes
       ====================================================== */

    header .header-inner > nav > #mainNav.active,
    header .header-inner > nav > #mainNav.open,
    header .header-inner > nav > #mainNav.show,
    header .header-inner > nav > #mainNav.mobile-open,
    header .header-inner > nav > #mainNav.menu-open,
    header .header-inner > nav > #mainNav.visible {
        opacity: 1 !important;

        visibility: visible !important;

        pointer-events: auto !important;

        transform:
            translateY(0)
            scale(1) !important;
    }


    /* ======================================================
       MOBILE MENU ITEMS
       ====================================================== */

    header .header-inner > nav > #mainNav > li {
        display: block !important;

        width: 100% !important;
        height: auto !important;

        margin: 0 !important;
        padding: 0 !important;
    }


    header .header-inner > nav > #mainNav > li > a {
        display: flex !important;

        align-items: center !important;
        justify-content: flex-start !important;

        width: 100% !important;
        min-height: 46px !important;

        margin: 0 !important;
        padding:
            0 14px !important;

        box-sizing: border-box !important;

        border-radius: 11px !important;

        color: #334155 !important;

        background: transparent !important;

        font-size: 14px !important;
        font-weight: 600 !important;

        line-height: 1 !important;

        text-decoration: none !important;

        transform: translateX(0) !important;

        transition:
            color .2s ease,
            background .2s ease,
            transform .22s cubic-bezier(.22,1,.36,1) !important;
    }


    header .header-inner > nav > #mainNav > li > a:hover {
        color: #dc2626 !important;

        background:
            rgba(220,38,38,.065) !important;

        transform:
            translateX(4px) !important;
    }


    header .header-inner > nav > #mainNav > li > a:active {
        transform:
            translateX(2px)
            scale(.985) !important;
    }


    /* Remove desktop underline animation from mobile links */

    header .header-inner > nav > #mainNav > li > a::after {
        display: none !important;
        content: none !important;
    }


    /* ======================================================
       MOBILE LOGIN
       ====================================================== */

    header .header-inner > nav > #mainNav > li > a.admin-login-btn {
        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        width: 100% !important;
        min-height: 44px !important;

        margin:
            5px 0 2px !important;

        padding: 0 16px !important;

        border-radius: 11px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef4444,
                #dc2626
            ) !important;

        box-shadow:
            0 7px 17px rgba(220,38,38,.20) !important;

        font-weight: 700 !important;

        transform: none !important;
    }


    header .header-inner > nav > #mainNav > li > a.admin-login-btn:hover {
        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #f04444,
                #c91f1f
            ) !important;

        transform:
            translateY(-1px) !important;

        box-shadow:
            0 10px 22px rgba(220,38,38,.27) !important;
    }


    /* ======================================================
       REDUCED MOTION
       ====================================================== */

    @media (prefers-reduced-motion: reduce) {

        header,
        header *,
        header *::before,
        header *::after {
            transition: none !important;
            animation: none !important;
        }
    }
}


/* ==========================================================
   JHARJEEVAN — FINAL DESKTOP HOME / HERO
   10/10 PREMIUM POLISH
   MOBILE COMPLETELY UNTOUCHED
   ========================================================== */

@media screen and (min-width: 769px) {

    /* ======================================================
       HERO CONTAINER
       ====================================================== */

    #home.hero {
        position: relative !important;

        height: 500px !important;
        min-height: 500px !important;

        overflow: hidden !important;

        isolation: isolate !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        background-color: #171717 !important;
    }


    /* ======================================================
       PREMIUM IMAGE DEPTH
       ====================================================== */

    #home.hero::before {
        content: "" !important;

        position: absolute !important;

        inset: -3% !important;

        z-index: 0 !important;

        background: inherit !important;

        transform: scale(1.03) !important;

        animation:
            heroBackgroundZoom 14s ease-in-out infinite alternate !important;

        transform-origin: center center !important;

        pointer-events: none !important;
    }


    /* ======================================================
       PREMIUM DARK GRADIENT OVERLAY
       ====================================================== */

    #home.hero::after {
        content: "" !important;

        position: absolute !important;

        inset: 0 !important;

        z-index: 1 !important;

        pointer-events: none !important;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.42) 0%,
                rgba(0,0,0,.18) 35%,
                rgba(0,0,0,.30) 100%
            ),
            linear-gradient(
                180deg,
                rgba(0,0,0,.18) 0%,
                rgba(0,0,0,.04) 42%,
                rgba(0,0,0,.38) 100%
            ) !important;
    }


    /* ======================================================
       HERO CONTENT
       ====================================================== */

    #home.hero .hero-content {
        position: relative !important;

        z-index: 3 !important;

        width: min(1050px, calc(100% - 80px)) !important;

        max-width: 1050px !important;

        margin:
            -4px auto 0 !important;

        padding: 0 !important;

        text-align: center !important;

        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;

        animation:
            heroContentEnter .85s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ======================================================
       EYEBROW / BE A HERO
       ====================================================== */

    #home.hero .hero-content .eyebrow,
    #home.hero .hero-content .hero-eyebrow,
    #home.hero .hero-content .subtitle {
        position: relative !important;

        display: inline-block !important;

        margin-bottom: 14px !important;

        color: #ff3b3b !important;

        font-size: 13px !important;

        font-weight: 800 !important;

        letter-spacing: 5px !important;

        line-height: 1.4 !important;

        text-transform: uppercase !important;

        text-shadow:
            0 2px 12px rgba(0,0,0,.35) !important;

        animation:
            heroEyebrow 1s .1s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ======================================================
       MAIN HEADING
       ====================================================== */

    #home.hero .hero-content h2 {
        position: relative !important;

        max-width: 1000px !important;

        margin:
            0 auto 18px !important;

        padding: 0 !important;

        color: #ffffff !important;

        font-size: clamp(48px, 5vw, 70px) !important;

        font-weight: 900 !important;

        line-height: 1.02 !important;

        letter-spacing: -2.8px !important;

        text-align: center !important;

        text-wrap: balance !important;

        text-shadow:
            0 4px 18px rgba(0,0,0,.42),
            0 10px 35px rgba(0,0,0,.20) !important;

        animation:
            heroHeading .9s .12s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ======================================================
       DESCRIPTION
       ====================================================== */

    #home.hero .hero-content p {
        max-width: 700px !important;

        margin:
            0 auto 30px !important;

        padding: 0 !important;

        color:
            rgba(255,255,255,.94) !important;

        font-size: 17px !important;

        font-weight: 500 !important;

        line-height: 1.65 !important;

        text-align: center !important;

        text-shadow:
            0 2px 10px rgba(0,0,0,.55) !important;

        animation:
            heroParagraph .9s .22s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ======================================================
       BUTTON AREA
       ====================================================== */

    #home.hero .hero-buttons,
    #home.hero .hero-actions,
    #home.hero .buttons {
        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        gap: 20px !important;

        margin-top: 2px !important;

        animation:
            heroButtons .9s .34s cubic-bezier(.22,1,.36,1) both !important;
    }


    /* ======================================================
       ALL HERO BUTTONS
       ====================================================== */

    #home.hero .btn,
    #home.hero button,
    #home.hero a.btn {
        position: relative !important;

        min-width: 190px !important;

        min-height: 56px !important;

        padding:
            0 28px !important;

        border-radius: 13px !important;

        font-size: 15px !important;

        font-weight: 800 !important;

        letter-spacing: -.1px !important;

        overflow: hidden !important;

        transform: translateY(0) !important;

        transition:
            transform .28s cubic-bezier(.22,1,.36,1),
            box-shadow .28s ease,
            background .28s ease,
            border-color .28s ease !important;
    }


    /* ======================================================
       PRIMARY BUTTON
       ====================================================== */

    #home.hero .btn.primary,
    #home.hero .btn:not(.secondary):not(.outline) {
        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ff3b3b 0%,
                #dc2626 55%,
                #b91c1c 100%
            ) !important;

        border: 1px solid rgba(255,255,255,.10) !important;

        box-shadow:
            0 10px 28px rgba(220,38,38,.28),
            0 2px 6px rgba(0,0,0,.16) !important;
    }


    #home.hero .btn.primary:hover,
    #home.hero .btn:not(.secondary):not(.outline):hover {
        transform:
            translateY(-4px) !important;

        box-shadow:
            0 17px 38px rgba(220,38,38,.38),
            0 5px 12px rgba(0,0,0,.20) !important;

        filter:
            brightness(1.04) !important;
    }


    /* ======================================================
       SECONDARY BUTTON
       ====================================================== */

    #home.hero .btn.secondary,
    #home.hero .btn.outline {
        color: #ffffff !important;

        background:
            rgba(255,255,255,.08) !important;

        border:
            2px solid rgba(255,255,255,.82) !important;

        box-shadow:
            0 8px 25px rgba(0,0,0,.16) !important;

        backdrop-filter:
            blur(8px) !important;

        -webkit-backdrop-filter:
            blur(8px) !important;
    }


    #home.hero .btn.secondary:hover,
    #home.hero .btn.outline:hover {
        color: #ffffff !important;

        background:
            rgba(255,255,255,.17) !important;

        border-color:
            #ffffff !important;

        transform:
            translateY(-4px) !important;

        box-shadow:
            0 14px 32px rgba(0,0,0,.25) !important;
    }


    /* ======================================================
       BUTTON SHINE EFFECT
       ====================================================== */

    #home.hero .btn::before,
    #home.hero a.btn::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: -120% !important;

        width: 65% !important;
        height: 100% !important;

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(255,255,255,.24),
                transparent
            ) !important;

        transform: skewX(-20deg) !important;

        transition:
            left .65s ease !important;

        pointer-events: none !important;
    }


    #home.hero .btn:hover::before,
    #home.hero a.btn:hover::before {
        left: 150% !important;
    }


    /* ======================================================
       HERO KEYFRAMES
       ====================================================== */

    @keyframes heroBackgroundZoom {

        0% {
            transform: scale(1.03);
        }

        100% {
            transform: scale(1.08);
        }
    }


    @keyframes heroContentEnter {

        0% {
            opacity: 0;
            transform: translateY(24px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @keyframes heroEyebrow {

        0% {
            opacity: 0;
            transform:
                translateY(12px)
                scale(.96);
        }

        100% {
            opacity: 1;
            transform:
                translateY(0)
                scale(1);
        }
    }


    @keyframes heroHeading {

        0% {
            opacity: 0;
            transform:
                translateY(18px)
                scale(.985);
        }

        100% {
            opacity: 1;
            transform:
                translateY(0)
                scale(1);
        }
    }


    @keyframes heroParagraph {

        0% {
            opacity: 0;
            transform: translateY(15px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }


    @keyframes heroButtons {

        0% {
            opacity: 0;
            transform: translateY(18px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ======================================================
       REDUCE MOTION ACCESSIBILITY
       ====================================================== */

    @media (prefers-reduced-motion: reduce) {

        #home.hero::before,
        #home.hero .hero-content,
        #home.hero .hero-content *,
        #home.hero .btn::before {
            animation: none !important;
            transition: none !important;
        }
    }
}


/* ==========================================================
   JHARJEEVAN — FINAL DESKTOP HERO REFINEMENT
   ONLY DESKTOP — MOBILE UNTOUCHED
   ========================================================== */

