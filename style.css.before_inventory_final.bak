            #c91f1f
        ) !important;

        transform: translateY(-2px) !important;

        box-shadow: 0 11px 25px rgba(220,38,38,.30) !important;
    }

    /* Mobile menu stays hidden on desktop */

    header .mobile-menu {
        display: none !important;
    }
}


