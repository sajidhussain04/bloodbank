        width: 32px !important;
    }


    /* ---------- NAV ---------- */

    header nav {
        display: flex !important;
        align-items: center !important;

        height: 100% !important;

        margin-left: auto !important;
    }


    header nav ul {
        display: flex !important;
        align-items: center !important;

        height: 100% !important;

        gap: 6px !important;

        margin: 0 !important;
        padding: 0 !important;

        list-style: none !important;
    }


    header nav li {
        display: flex !important;
        align-items: center !important;

        height: 100% !important;

        margin: 0 !important;
        padding: 0 !important;
    }


    /* ---------- NAV LINKS ---------- */

    header nav a {
        position: relative !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        min-height: 42px !important;

        padding: 0 15px !important;

        border-radius: 11px !important;

        color: #334155 !important;

        font-size: 15px !important;
        font-weight: 600 !important;

        line-height: 1 !important;

        white-space: nowrap !important;

        text-decoration: none !important;

        transition:
            color .25s ease,
            background .25s ease,
            transform .25s ease,
            box-shadow .25s ease !important;
    }


    header nav a::before {
        content: "" !important;

        position: absolute !important;

        left: 50% !important;
        bottom: 5px !important;

        width: 0 !important;
        height: 2px !important;

        border-radius: 999px !important;

        background: #dc2626 !important;

        transform: translateX(-50%) !important;

        transition: width .25s ease !important;
    }


    header nav a:hover {
        color: #dc2626 !important;

        background: rgba(220, 38, 38, 0.055) !important;

        transform: translateY(-1px) !important;
    }


    header nav a:hover::before {
        width: 22px !important;
    }


    /* ---------- LOGIN ---------- */

    header nav a[href*="login"],
    header nav a[href*="admin"],
    header nav .login,
    header nav .login-btn {
        margin-left: 9px !important;

        min-width: 76px !important;
        min-height: 42px !important;

        padding: 0 19px !important;

        border-radius: 10px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef4444 0%,
                #dc2626 55%,
                #c81e1e 100%
            ) !important;

        box-shadow:
            0 8px 18px rgba(220,38,38,.22),
            inset 0 1px 0 rgba(255,255,255,.20) !important;

        font-weight: 700 !important;

        transition:
            transform .25s ease,
            box-shadow .25s ease,
            filter .25s ease !important;
    }


    header nav a[href*="login"]::before,
    header nav a[href*="admin"]::before,
    header nav .login::before,
    header nav .login-btn::before {
        display: none !important;
    }


    header nav a[href*="login"]:hover,
    header nav a[href*="admin"]:hover,
    header nav .login:hover,
    header nav .login-btn:hover {
        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #f05252,
                #dc2626
            ) !important;

        transform: translateY(-2px) !important;

        box-shadow:
            0 12px 26px rgba(220,38,38,.30),
            inset 0 1px 0 rgba(255,255,255,.25) !important;

        filter: brightness(1.03) !important;
    }


    header nav a[href*="login"]:active,
    header nav a[href*="admin"]:active,
    header nav .login:active,
    header nav .login-btn:active {
        transform: translateY(0) scale(.97) !important;
    }


    /* ---------- PAGE OFFSET ---------- */

    body {
        padding-top: 78px !important;
    }


    /* ---------- ANCHOR OFFSET ---------- */

    section[id] {
        scroll-margin-top: 94px !important;
    }


    /* ---------- NAVBAR ANIMATION ---------- */

    @keyframes jjNavbarEnter {

        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }


    /* ---------- ACCESSIBILITY ---------- */

    @media (prefers-reduced-motion: reduce) {

        header {
            animation: none !important;
        }

        header *,
        header *::before,
        header *::after {
            transition: none !important;
        }

    }

}


