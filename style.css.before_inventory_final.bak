        box-shadow:
            0 18px 45px rgba(15,23,42,.075) !important;

        position: relative !important;

        overflow: hidden !important;
    }


    /* --------------------------------------------------------
       LEFT INFORMATION CARD
       -------------------------------------------------------- */

    #donate.donate-section .donate-info {
        padding: 34px 32px 30px !important;

        min-height: 0 !important;
        height: auto !important;
    }


    /* --------------------------------------------------------
       LEFT CARD TOP DECORATION
       -------------------------------------------------------- */

    #donate.donate-section .donate-info::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 4px !important;

        background:
            linear-gradient(
                90deg,
                #ef4444,
                #dc2626
            ) !important;
    }


    /* --------------------------------------------------------
