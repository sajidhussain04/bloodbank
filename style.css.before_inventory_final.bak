       -------------------------------------------------------- */

    #donate.donate-section .benefits {
        margin-top: 25px !important;

        padding-top: 22px !important;

        border-top:
            1px solid rgba(148,163,184,.20) !important;
    }


    #donate.donate-section .benefits h3 {
        margin: 0 0 17px !important;

        color: #dc2626 !important;

        font-size: 19px !important;
    }


    #donate.donate-section .benefits ul {
        margin: 0 !important;
        padding: 0 !important;

        list-style: none !important;

        display: grid !important;

        grid-template-columns: 1fr !important;

        gap: 13px !important;
    }


    #donate.donate-section .benefits li {
        display: flex !important;

        align-items: center !important;

        gap: 12px !important;

        color: #526174 !important;

        font-size: 14px !important;

        line-height: 1.4 !important;
    }


    #donate.donate-section .benefits li::before {
        content: "✓" !important;

        color: #16a34a !important;

        font-size: 18px !important;

        font-weight: 800 !important;
    }


    /* --------------------------------------------------------
       RIGHT REGISTRATION CARD
       -------------------------------------------------------- */

    #donate.donate-section .donate-form {
        padding: 34px 30px 30px !important;

        min-height: 0 !important;

        height: auto !important;

        display: flex !important;

        flex-direction: column !important;
    }


    #donate.donate-section .donate-form::before {
        content: "" !important;

        position: absolute !important;

        top: 0 !important;
        left: 0 !important;
        right: 0 !important;

        height: 4px !important;

        background:
            linear-gradient(
                90deg,
                #ef4444,
                #c81e1e
            ) !important;
    }


    /* --------------------------------------------------------
       FORM HEADING
       -------------------------------------------------------- */

    #donate.donate-section .donate-form h3 {
        margin: 0 0 6px !important;

        color: #172033 !important;

        font-size: 23px !important;

        line-height: 1.25 !important;

        letter-spacing: -.4px !important;
    }


    #donate.donate-section .donate-form > p {
        margin: 0 0 26px !important;

        color: #94a3b8 !important;

        font-size: 13px !important;

        line-height: 1.5 !important;
    }


    /* --------------------------------------------------------
       FORM CONTROLS
       -------------------------------------------------------- */

    #donate.donate-section .donate-form form {
        display: flex !important;

        flex-direction: column !important;

        gap: 14px !important;

        width: 100% !important;

        margin: 0 !important;
    }


    #donate.donate-section .donate-form input,
    #donate.donate-section .donate-form select,
    #donate.donate-section .donate-form textarea {
        width: 100% !important;

        min-height: 50px !important;

        box-sizing: border-box !important;

        margin: 0 !important;

        padding: 0 15px !important;

        border:
            1px solid #dce3eb !important;

        border-radius: 13px !important;

        background: #ffffff !important;

        color: #172033 !important;

        font-family: inherit !important;

        font-size: 14px !important;

        outline: none !important;

        transition:
            border-color .2s ease,
            box-shadow .2s ease,
            transform .2s ease !important;
    }


    #donate.donate-section .donate-form input::placeholder {
        color: #9aa8ba !important;
    }


    #donate.donate-section .donate-form input:focus,
    #donate.donate-section .donate-form select:focus,
    #donate.donate-section .donate-form textarea:focus {
        border-color: #ef4444 !important;

        box-shadow:
            0 0 0 4px rgba(239,68,68,.09) !important;
    }


    #donate.donate-section .donate-form select {
        cursor: pointer !important;
    }


    /* --------------------------------------------------------
       REGISTER BUTTON
       -------------------------------------------------------- */

    #donate.donate-section .donate-form button,
    #donate.donate-section .donate-form .btn {
        width: 100% !important;

        min-height: 52px !important;

        margin: 8px 0 0 !important;

        border: 0 !important;

        border-radius: 13px !important;

        color: #ffffff !important;

        background:
            linear-gradient(
                135deg,
                #ef3035,
                #d91f26
            ) !important;

        box-shadow:
            0 12px 24px rgba(220,38,38,.20) !important;

        font-size: 15px !important;

        font-weight: 700 !important;

        cursor: pointer !important;

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            filter .2s ease !important;
    }


    #donate.donate-section .donate-form button:hover,
    #donate.donate-section .donate-form .btn:hover {
        transform: translateY(-2px) !important;

        box-shadow:
            0 16px 30px rgba(220,38,38,.27) !important;

        filter: brightness(1.03) !important;
    }


    #donate.donate-section .donate-form button:active,
    #donate.donate-section .donate-form .btn:active {
        transform: translateY(0) scale(.99) !important;
    }


    /* --------------------------------------------------------
       FORM MESSAGE / STATUS
       -------------------------------------------------------- */

    #donate.donate-section .form-message,
    #donate.donate-section .form-status {
        margin-top: 12px !important;

        font-size: 13px !important;

        line-height: 1.5 !important;
    }


    /* --------------------------------------------------------
       DECORATIVE HEART — SUBTLE
       -------------------------------------------------------- */

    #donate.donate-section .donate-info::after {
        content: "♥" !important;

        position: absolute !important;

        right: 28px !important;
        bottom: 24px !important;

        color: rgba(220,38,38,.07) !important;

        font-size: 56px !important;

        line-height: 1 !important;

        pointer-events: none !important;
    }


    /* --------------------------------------------------------
       PREMIUM HOVER
       -------------------------------------------------------- */

    #donate.donate-section .donate-info,
    #donate.donate-section .donate-form {
        transition:
            transform .25s ease,
            box-shadow .25s ease !important;
    }


    #donate.donate-section .donate-info:hover,
    #donate.donate-section .donate-form:hover {
        transform: translateY(-3px) !important;

        box-shadow:
            0 22px 50px rgba(15,23,42,.10) !important;
    }

}


